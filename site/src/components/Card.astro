---
// Card — Unified card shell component
//
// Single source of truth for card-level CSS across all collection
// index pages and the search palette.
//
// USAGE (named slots — standard cards):
//   <Card href="/sqlkraft/dmvs/sys-dm-exec-requests/">
//     <span slot="title">{name}</span>
//     <span slot="meta" class="return-badge">{returnType}</span>
//     <p slot="description">{description}</p>
//     <div slot="tags">
//       <span class="card-tag">#tag1</span>
//       <span class="card-tag">#tag2</span>
//     </div>
//   </Card>
//
// USAGE (default slot — complex cards with extra elements):
//   <Card href="/sqlkraft/wait-statistics/async_network_io/">
//     <div class="card-header">
//       <span class="card-title">{name}</span>
//       <span class="card-meta">{severity}</span>
//     </div>
//     ... custom content ...
//     <div class="card-tags">...</div>
//   </Card>

export interface Props {
  href: string;
  "data-cat"?: string;
  notransition?: boolean;
}

const { href, "data-cat": dataCat, notransition } = Astro.props;
const hasTitle = Astro.slots.has("title");
const extraAttrs: Record<string, string> = {};
if (dataCat !== undefined) extraAttrs["data-cat"] = dataCat;

// Derive unique transition name from the href slug for view transition morphing
// Skip on pages with very high card counts (notransition) to prevent
// browser-thread freeze from excessive named elements during View Transitions
const transitionName = href.replace(/\/+$/, "").split("/").pop() || "";
const titleAttrs: Record<string, string> = {};
if (!notransition) titleAttrs["transition:name"] = transitionName;
---

<a href={href} class="item-card" {...extraAttrs}>
  {
    hasTitle ? (
      <>
        <div class="card-header">
          <span class="card-title" {...titleAttrs}>
            <slot name="title" />
          </span>
          {Astro.slots.has("meta") && <slot name="meta" />}
        </div>
        {Astro.slots.has("description") && (
          <p class="card-desc">
            <slot name="description" />
          </p>
        )}
        {Astro.slots.has("tags") && (
          <div class="card-tags">
            <slot name="tags" />
          </div>
        )}
      </>
    ) : (
      <slot />
    )
  }
</a>

<style is:global>
  /* ═══════════════════════════════════════════════════════════
     UNIFIED CARD SHELL — Wait Statistics Blueprint v2
     Cloned from the gold-standard Wait Statistics card design.
     Every metric — padding, gap, font, border, height — matches
     the wait-statistics dashboard tokens exactly.
     ═══════════════════════════════════════════════════════════ */

  .item-card {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.6vw, 8px);
    padding: clamp(12px, 1.5vw, 22px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(6px, 0.8vw, 10px);
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    min-width: 0;
    /* Wait Stats uniform card height enforcement */
    min-height: 160px;
    transition:
      border-color 0.25s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.35s cubic-bezier(0.25, 1, 0.5, 1),
      background 0.25s cubic-bezier(0.25, 1, 0.5, 1),
      box-shadow 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    background: rgba(13, 17, 23, 0.8);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(4px, 0.8vw, 10px);
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.2vw, 14px);
    font-weight: 600;
    color: var(--text-primary);
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
    min-width: 0;
  }

  .card-meta {
    flex-shrink: 0;
  }

  .card-desc {
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
    /* Stretch description to fill card height, pushing tags to bottom */
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(3px, 0.4vw, 6px);
    margin-top: auto;
  }

  .card-tag {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .card-tag-more {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    opacity: 0.7;
  }
</style>
