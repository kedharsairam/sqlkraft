---
// SearchOverlay — Fuse.js client-side search modal
// Keyboard: Ctrl+K / Cmd+K to open, Esc to close
---

<div id="search-overlay" class="search-overlay hidden" role="dialog" aria-label="Search">
  <div class="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-input-wrap">
      <svg
        class="search-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Search DMVs, errors, functions, statements..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-hint">ESC</kbd>
    </div>
    <div id="search-results" class="search-results">
      <div class="search-empty">Start typing to search...</div>
    </div>
  </div>
</div>

<script>
  (async function () {
    const overlay = document.getElementById("search-overlay");
    const input = document.getElementById("search-input");
    const results = document.getElementById("search-results");

    if (!overlay || !input || !results) return;

    // Lazy-load Fuse.js
    const Fuse = (await import("fuse.js")).default;

    // Load search index
    const resp = await fetch("/sqlkraft/data/search-index.json");
    const indexData = await resp.json();

    // Configure Fuse
    const fuse = new Fuse(indexData, {
      keys: [
        { name: "name", weight: 3 },
        { name: "title", weight: 2 },
        { name: "description", weight: 1 },
        { name: "tags", weight: 2 },
        { name: "category", weight: 1 },
      ],
      threshold: 0.4,
      includeScore: true,
      minMatchCharLength: 2,
    });

    // Track recently selected
    let recent = JSON.parse(sessionStorage.getItem("sk_recent") || "[]");

    function renderRecent() {
      if (recent.length === 0) {
        results.innerHTML = '<div class="search-empty">Start typing to search...</div>';
        return;
      }
      let html = '<div class="search-section-label">Recently viewed</div>';
      recent.forEach((r) => {
        html += renderResultItem(r);
      });
      results.innerHTML = html;
    }

    function renderResultItem(r) {
      const coll = r.collection || "";
      const cat = r.category ? `<span class="result-cat">${r.category}</span>` : "";
      const desc = r.description
        ? `<div class="result-desc">${r.description.slice(0, 120)}</div>`
        : "";
      const tags =
        r.tags && r.tags.length
          ? r.tags
              .slice(0, 3)
              .map((t) => `<span class="result-tag">${t}</span>`)
              .join("")
          : "";
      return `<a href="/sqlkraft/${coll}/${r.slug}/" class="result-item">
        <div class="result-top">
          <span class="result-name">${r.name || r.title}</span>
          ${cat}
          <span class="result-coll">${coll}</span>
        </div>
        ${desc}
        <div class="result-tags">${tags}</div>
      </a>`;
    }

    // Keyboard shortcut: Ctrl+K / Cmd+K
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        overlay.classList.remove("hidden");
        input.value = "";
        input.focus();
        renderRecent();
      }
      if (e.key === "Escape" && !overlay.classList.contains("hidden")) {
        overlay.classList.add("hidden");
        input.blur();
      }
    });

    // Click backdrop to close
    overlay.querySelector(".search-backdrop").addEventListener("click", () => {
      overlay.classList.add("hidden");
    });

    // Search on input
    let timeout = null;
    input.addEventListener("input", () => {
      clearTimeout(timeout);
      timeout = setTimeout(() => {
        const q = input.value.trim();
        if (q.length < 2) {
          renderRecent();
          return;
        }
        const raw = fuse.search(q);
        const items = raw.slice(0, 20).map((r) => r.item);
        if (items.length === 0) {
          results.innerHTML = '<div class="search-empty">No results found</div>';
          return;
        }
        results.innerHTML = items.map((r) => renderResultItem(r)).join("");
      }, 150);
    });

    // Track click on result items for recent list
    results.addEventListener("click", (e) => {
      const link = e.target.closest("a.result-item");
      if (!link) return;
      const idx = indexData.find((r) => link.href.endsWith(`/${r.slug}/`));
      if (idx) {
        recent = recent.filter((r) => r.slug !== idx.slug);
        recent.unshift(idx);
        if (recent.length > 5) recent.pop();
        sessionStorage.setItem("sk_recent", JSON.stringify(recent));
      }
    });
  })();
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
  }
  .search-overlay.hidden {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .search-panel {
    position: relative;
    width: 640px;
    max-width: 90vw;
    max-height: 60vh;
    background: var(--bg-secondary, #0d1117);
    border: 1px solid var(--border-glass, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-glass, rgba(255, 255, 255, 0.08));
  }
  .search-icon {
    color: var(--text-secondary, #8b949e);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text-primary, #e6edf3);
    font-size: 16px;
    font-family: var(--font-sans, sans-serif);
  }
  .search-input::placeholder {
    color: var(--text-secondary, #8b949e);
  }
  .search-hint {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary, #8b949e);
    font-family: var(--font-mono, monospace);
  }
  .search-results {
    overflow-y: auto;
    padding: 8px 0;
    flex: 1;
  }
  .search-empty {
    padding: 24px 18px;
    color: var(--text-secondary, #8b949e);
    text-align: center;
    font-size: 14px;
  }
  .search-section-label {
    padding: 8px 18px 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-secondary, #8b949e);
    letter-spacing: 0.5px;
  }
  .result-item {
    display: block;
    padding: 10px 18px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .result-item:hover {
    background: rgba(47, 128, 237, 0.08);
    text-decoration: none;
  }
  .result-top {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .result-name {
    font-family: var(--font-mono, monospace);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent, #2f80ed);
  }
  .result-cat {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(47, 128, 237, 0.12);
    color: var(--accent, #2f80ed);
    text-transform: capitalize;
  }
  .result-coll {
    font-size: 10px;
    color: var(--text-secondary, #8b949e);
    margin-left: auto;
  }
  .result-desc {
    font-size: 13px;
    color: var(--text-secondary, #8b949e);
    margin-top: 4px;
    line-height: 1.4;
  }
  .result-tags {
    display: flex;
    gap: 4px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .result-tag {
    font-size: 10px;
    color: var(--text-secondary, #8b949e);
    background: rgba(255, 255, 255, 0.05);
    padding: 1px 6px;
    border-radius: 3px;
    font-family: var(--font-mono, monospace);
  }
</style>
