---
// CardPalette — Runtime card renderer for search palette (v7 — compact rows)
//
// Provides window.__renderCard() which generates compact horizontal
// result rows for the search palette. No card styling — each result
// is a tight 44px horizontal row with title + badge.
//
// Must be included before SearchPalette.astro.
---

<!-- Runtime render function — generates a compact palette result row -->
<script is:inline>
  window.__renderCard = function (item, baseUrl, query) {
    var esc = function (s) {
      if (!s) return "";
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    };

    // Highlight exact query match in title (case-insensitive)
    function highlight(text, q) {
      if (!q || q.length < 2) return esc(text);
      var lowered = text.toLowerCase();
      var qLower = q.toLowerCase();
      var idx = lowered.indexOf(qLower);
      if (idx === -1) return esc(text);
      var before = esc(text.slice(0, idx));
      var match = esc(text.slice(idx, idx + q.length));
      var after = esc(text.slice(idx + q.length));
      return before + "<strong>" + match + "</strong>" + after;
    }

    var title = item.t || "";
    var desc = item.d || "";
    var url = (baseUrl || "") + item.u;
    var cat = item.c || "other";
    var labels = {
      dmvs: "DMVs",
      "wait-statistics": "Waits",
      scripts: "Scripts",
      cookbook: "Cookbook",
      "catalog-views": "Catalog",
      "stored-procedures": "SPs",
      functions: "Functions",
      "tsql-reference": "T-SQL",
      errors: "Errors",
      architecture: "Arch",
      operations: "Ops",
      xevents: "XEvents",
    };
    var badge =
      labels[cat] ||
      cat.replace(/-/g, " ").replace(/\b\w/g, function (c) {
        return c.toUpperCase();
      });

    // Result row: title (with highlight) + description + badge
    var html =
      '<a href="' +
      esc(url) +
      '" class="palette-result">' +
      '<span class="palette-result-body">' +
      '<span class="palette-result-title">' +
      highlight(title, query) +
      "</span>" +
      (desc ? '<span class="palette-result-desc">' + esc(desc.slice(0, 80)) + "</span>" : "") +
      "</span>" +
      '<span class="palette-badge palette-badge--' +
      cat +
      '">' +
      esc(badge) +
      "</span>" +
      "</a>";
    return html;
  };
</script>

<style is:global>
  /* ════════════════════════════════════════════════
     SEARCH PALETTE ROWS — compact 44px horizontal list
     No card blocks. No massive padding. No borders.
     Just tight rows with subtle hover state.
     ════════════════════════════════════════════════ */

  /* ── Result list reset ── */
  .palette-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── Result item wrapper — compact 44px row ── */
  .palette-item {
    margin: 0 4px;
    padding: 0;
    list-style: none;
    opacity: 0;
    animation: palette-result-enter 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    /* Visual separation between items */
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }
  .palette-item:last-child {
    border-bottom: none;
    margin-bottom: 4px;
  }

  @keyframes palette-result-enter {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Compact result row — no card styling ── */
  .palette-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    min-height: 44px;
    text-decoration: none !important;
    color: inherit;
    border-radius: 6px;
    transition: background 0.1s ease;
  }

  /* Subtle background change on hover — no border, no transform, no shadow */
  .palette-result:hover {
    background: rgba(255, 255, 255, 0.05);
    text-decoration: none !important;
  }

  /* Active (keyboard selection) — accent tint only */
  .palette-result.active {
    background: rgba(47, 128, 237, 0.08);
  }
  .palette-result.active:hover {
    background: rgba(47, 128, 237, 0.1);
  }

  /* ── Result body — title + description stacked ── */
  .palette-result-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  /* ── Title — single line, ellipsis overflow ── */
  .palette-result-title {
    font-size: 14px;
    font-weight: 450;
    color: var(--text-primary, #e6edf3);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .palette-result-title strong {
    font-weight: 600;
    color: #58a6ff;
  }

  /* ── Description — single line subtitle ── */
  .palette-result-desc {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Category badge ── */
  .palette-badge {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    line-height: 1.4;
  }

  /* Colored badges per collection */
  .palette-badge--dmvs {
    color: #58a6ff;
    background: rgba(88, 166, 255, 0.12);
  }
  .palette-badge--wait-statistics {
    color: #d29922;
    background: rgba(210, 153, 34, 0.12);
  }
  .palette-badge--scripts {
    color: #3fb950;
    background: rgba(63, 185, 80, 0.12);
  }
  .palette-badge--cookbook {
    color: #bc8cff;
    background: rgba(188, 140, 255, 0.12);
  }
  .palette-badge--catalog-views {
    color: #79c0ff;
    background: rgba(121, 192, 255, 0.12);
  }
  .palette-badge--stored-procedures {
    color: #f778ba;
    background: rgba(247, 120, 186, 0.12);
  }
  .palette-badge--functions {
    color: #56d4dd;
    background: rgba(86, 212, 221, 0.12);
  }
  .palette-badge--tsql-reference {
    color: #ffa657;
    background: rgba(255, 166, 87, 0.12);
  }
  .palette-badge--errors {
    color: #f85149;
    background: rgba(248, 81, 73, 0.12);
  }
  .palette-badge--architecture {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.06);
  }
  .palette-badge--operations {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.06);
  }
  .palette-badge--xevents {
    color: #79c0ff;
    background: rgba(121, 192, 255, 0.12);
  }
</style>
