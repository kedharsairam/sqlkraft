---
import SearchOverlay from "../components/SearchOverlay.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "SqlKraft", description = "SQL Server Reference Hub" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SqlKraft</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/sqlkraft/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <nav class="nav-bar">
      <div class="nav-inner">
        <a href="/sqlkraft/" class="nav-brand">SqlKraft.</a>
        <div class="nav-links">
          <a href="/sqlkraft/dmvs/">DMVs</a>
          <a href="/sqlkraft/wait-statistics/">Waits</a>
          <a href="/sqlkraft/errors/">Errors</a>
          <a href="/sqlkraft/catalog-views/">Catalog</a>
          <a href="/sqlkraft/functions/">Functions</a>
          <a href="/sqlkraft/stored-procedures/">SPs</a>
          <a href="/sqlkraft/tsql-reference/">T-SQL</a>
          <a href="/sqlkraft/architecture/">Arch</a>
          <a href="/sqlkraft/scripts/">Scripts</a>
        </div>
        <button id="search-btn" class="nav-search-btn" aria-label="Search (Ctrl+K)">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
          </svg>
          <span class="search-shortcut">Ctrl+K</span>
        </button>
      </div>
    </nav>
    <main class="app-shell">
      <slot />
    </main>
    <SearchOverlay />
  </body>
</html>

<script>
  // Wire up search button to open the overlay
  document.getElementById("search-btn")?.addEventListener("click", () => {
    const overlay = document.getElementById("search-overlay");
    if (overlay) {
      overlay.classList.remove("hidden");
      const input = document.getElementById("search-input");
      if (input) {
        input.value = "";
        input.focus();
      }
    }
  });
</script>

<style is:global>
  :root {
    --bg-primary: #000000;
    --bg-secondary: #0d1117;
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --accent: #2f80ed;
    --border-glass: rgba(255, 255, 255, 0.08);
    --color-muted: #9ca3af;
    --font-sans: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "SF Mono", "Cascadia Code", Consolas, monospace;
    --max-width: 1040px;
    --nav-height: 56px;

    /* ── Fluid spacing & layout tokens ── */
    --content-max-width: min(var(--max-width), 92vw);
    --fluid-gap-sm: clamp(8px, 1vw, 16px);
    --fluid-gap-md: clamp(16px, 2vw, 28px);
    --fluid-gap-lg: clamp(24px, 3vw, 48px);
    --fluid-padding-h: clamp(16px, 3vw, 32px);
    --fluid-padding-v: clamp(24px, 3vw, 48px);
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
  }
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-glass);
    z-index: 100;
  }
  .nav-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--fluid-padding-h);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: clamp(8px, 1.5vw, 16px);
  }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: clamp(11px, 1.3vw, 14px);
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }
  .nav-search-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-glass);
    border-radius: 6px;
    padding: 5px 10px;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.2s,
      color 0.2s;
    margin-left: 12px;
  }
  .nav-search-btn:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }
  .search-shortcut {
    font-size: 11px;
    font-family: var(--font-mono);
    opacity: 0.6;
  }
  .app-shell {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + clamp(24px, 3vw, 48px)) var(--fluid-padding-h)
      var(--fluid-padding-v);
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  /* ── Responsive tables (scrollable on narrow viewports) ── */
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
    font-size: clamp(12px, 1.2vw, 14px);
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }
  .body-content th,
  .body-content td {
    padding: clamp(6px, 1vw, 12px) clamp(8px, 1.2vw, 14px);
  }
  @media (max-width: 540px) {
    .body-content table {
      font-size: 12px;
    }
    .body-content th,
    .body-content td {
      padding: 6px 10px;
    }
  }

  /* ── Fluid code blocks ── */
  .body-content pre {
    padding: clamp(12px, 2vw, 24px) !important;
    border-radius: clamp(6px, 1vw, 10px);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem) !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .body-content :not(pre) > code {
    font-size: clamp(0.8rem, 1.1vw, 0.9rem) !important;
    padding: clamp(1px, 0.3vw, 6px) clamp(3px, 0.5vw, 8px) !important;
  }

  /* ── Fluid headings in body content ── */
  .body-content h2 {
    font-size: clamp(1.1rem, 2vw, 1.4rem) !important;
  }
  .body-content h3 {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem) !important;
  }
  .body-content p,
  .body-content li {
    font-size: clamp(0.85rem, 1.2vw, 0.95rem) !important;
  }
</style>
