---
import SearchOverlay from "../components/SearchOverlay.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "SqlKraft", description = "SQL Server Reference Hub" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SqlKraft</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/sqlkraft/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <nav class="nav-bar">
      <div class="nav-inner">
        <a href="/sqlkraft/" class="nav-brand">SqlKraft.</a>
        <div class="nav-links">
          <a href="/sqlkraft/dmvs/">DMVs</a>
          <a href="/sqlkraft/wait-statistics/">Waits</a>
          <a href="/sqlkraft/errors/">Errors</a>
          <a href="/sqlkraft/catalog-views/">Catalog</a>
          <a href="/sqlkraft/functions/">Functions</a>
          <a href="/sqlkraft/stored-procedures/">SPs</a>
          <a href="/sqlkraft/tsql-reference/">T-SQL</a>
          <a href="/sqlkraft/architecture/">Arch</a>
          <a href="/sqlkraft/scripts/">Scripts</a>
          <a href="/sqlkraft/cookbook/">Recipes</a>
        </div>
        <button id="search-btn" class="nav-search-btn" aria-label="Search (Ctrl+K)">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
          </svg>
          <span class="search-shortcut">Ctrl+K</span>
        </button>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="Open navigation menu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </nav>

    <!-- ── Mobile navigation drawer ── -->
    <div id="mobile-nav-drawer" class="mobile-nav-drawer">
      <div class="mobile-nav-drawer-inner">
        <button class="mobile-search-trigger" id="mobile-search-trigger">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
          </svg>
          <span>Search references</span>
          <kbd class="mobile-search-hint">Ctrl+K</kbd>
        </button>
        <div class="mobile-nav-links">
          <a href="/sqlkraft/dmvs/" class="mobile-nav-link">DMVs</a>
          <a href="/sqlkraft/wait-statistics/" class="mobile-nav-link">Waits</a>
          <a href="/sqlkraft/errors/" class="mobile-nav-link">Errors</a>
          <a href="/sqlkraft/catalog-views/" class="mobile-nav-link">Catalog</a>
          <a href="/sqlkraft/functions/" class="mobile-nav-link">Functions</a>
          <a href="/sqlkraft/stored-procedures/" class="mobile-nav-link">SPs</a>
          <a href="/sqlkraft/tsql-reference/" class="mobile-nav-link">T-SQL</a>
          <a href="/sqlkraft/architecture/" class="mobile-nav-link">Arch</a>
          <a href="/sqlkraft/scripts/" class="mobile-nav-link">Scripts</a>
          <a href="/sqlkraft/cookbook/" class="mobile-nav-link">Recipes</a>
        </div>
      </div>
    </div>
    <main class="app-shell">
      <slot />
    </main>
    <SearchOverlay />
  </body>
</html>

<script>
  // ── Mac detection: show ⌘K instead of Ctrl+K ──
  const isMac = navigator.platform.includes("Mac");
  if (isMac) {
    const badge = document.querySelector(".search-shortcut");
    if (badge) badge.textContent = "⌘K";
    const btn = document.getElementById("search-btn");
    if (btn) btn.setAttribute("aria-label", "Search (⌘K)");
  }

  // Wire up search button to open the overlay
  document.getElementById("search-btn")?.addEventListener("click", () => {
    const overlay = document.getElementById("search-overlay");
    if (overlay) {
      overlay.classList.remove("hidden");
      const input = document.getElementById("search-input");
      if (input) {
        input.value = "";
        input.focus();
      }
    }
  });

  // ── Mobile hamburger menu ──
  const hamburger = document.getElementById("hamburger-btn");
  const drawer = document.getElementById("mobile-nav-drawer");
  if (hamburger && drawer) {
    hamburger.addEventListener("click", () => {
      const isOpen = drawer.classList.toggle("is-active");
      hamburger.classList.toggle("is-active");
      hamburger.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu",
      );
      document.body.style.overflow = isOpen ? "hidden" : "";
    });

    // Close drawer when a nav link is tapped
    drawer.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        drawer.classList.remove("is-active");
        hamburger.classList.remove("is-active");
        hamburger.setAttribute("aria-label", "Open navigation menu");
        document.body.style.overflow = "";
      });
    });

    // Close drawer when search trigger is tapped
    const searchTrigger = document.getElementById("mobile-search-trigger");
    searchTrigger?.addEventListener("click", () => {
      drawer.classList.remove("is-active");
      hamburger.classList.remove("is-active");
      hamburger.setAttribute("aria-label", "Open navigation menu");
      document.body.style.overflow = "";
      // Open the search overlay
      const overlay = document.getElementById("search-overlay");
      if (overlay) {
        overlay.classList.remove("hidden");
        const input = document.getElementById("search-input");
        if (input) {
          input.value = "";
          input.focus();
        }
      }
    });
  }
</script>

<style is:global>
  :root {
    --bg-primary: #000000;
    --bg-secondary: #0d1117;
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --accent: #2f80ed;
    --border-glass: rgba(255, 255, 255, 0.08);
    --color-muted: #9ca3af;
    --font-sans: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "SF Mono", "Cascadia Code", Consolas, monospace;
    --max-width: 1500px;
    --nav-height: 56px;

    /* ── Fluid spacing & layout tokens ── */
    --content-max-width: min(var(--max-width), 95vw);
    --fluid-gap-sm: clamp(8px, 1vw, 16px);
    --fluid-gap-md: clamp(16px, 2vw, 28px);
    --fluid-gap-lg: clamp(24px, 3vw, 48px);
    --fluid-padding-h: clamp(16px, 3vw, 40px);
    --fluid-padding-v: clamp(24px, 3vw, 48px);

    /* ── Unified spacing rhythm ── */
    --space-xs: 0.5rem; /* 8px — h1→tagline */
    --space-sm: 0.75rem; /* 12px — tagline→subtitle */
    --space-md: 1.5rem; /* 24px — section breaks */
    --space-lg: 2.5rem; /* 40px — nav→title, subtitle→grid */
    --space-xl: 4rem; /* 64px — section top/bottom */

    /* ── Unified component tokens ── */
    --card-padding: 1.75rem; /* 28px — card inner padding on wide viewports */
    --code-padding: 1.75rem; /* 28px — code block inner padding */
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
  }
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-glass);
    z-index: 100;
  }
  .nav-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--fluid-padding-h);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: clamp(8px, 1.5vw, 16px);
  }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: clamp(11px, 1.3vw, 14px);
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }
  .nav-search-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-glass);
    border-radius: 6px;
    padding: 5px 10px;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.2s,
      color 0.2s;
    margin-left: 12px;
  }
  .nav-search-btn:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
  .search-shortcut {
    font-size: 11px;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-glass);
    border-radius: 4px;
    padding: 2px 6px;
    line-height: 1;
    color: var(--text-secondary);
  }
  .app-shell {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-lg)) var(--fluid-padding-h) var(--fluid-padding-v);
  }
  a {
    color: var(--text-primary);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  /* ── Responsive tables (scrollable on narrow viewports) ── */
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
    font-size: clamp(12px, 1.2vw, 14px);
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }
  .body-content th,
  .body-content td {
    padding: clamp(6px, 1vw, 12px) clamp(8px, 1.2vw, 14px);
  }
  @media (max-width: 540px) {
    .body-content table {
      font-size: 12px;
    }
    .body-content th,
    .body-content td {
      padding: 6px 10px;
    }
  }

  /* ── Fluid code blocks (1.75rem max padding) ── */
  .body-content pre {
    padding: clamp(12px, 2vw, 28px) !important;
    border-radius: clamp(6px, 1vw, 10px);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem) !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .body-content :not(pre) > code {
    font-size: clamp(0.8rem, 1.1vw, 0.9rem) !important;
    padding: clamp(1px, 0.3vw, 6px) clamp(3px, 0.5vw, 8px) !important;
  }

  /* ── Hamburger toggle button (hidden on desktop) ── */
  .hamburger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: 8px;
  }
  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition:
      transform 0.2s ease-out,
      opacity 0.2s ease-out;
    transform-origin: center;
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Mobile navigation drawer (full-screen overlay) ── */
  .mobile-nav-drawer {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    background: rgba(0, 0, 0, 0.97);
    backdrop-filter: blur(16px);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav-drawer.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mobile-nav-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--fluid-padding-h);
    max-width: 500px;
  }

  /* Mobile search trigger at top of drawer */
  .mobile-search-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: var(--space-md);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 15px;
    cursor: pointer;
    margin-bottom: var(--space-md);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .mobile-search-trigger:hover,
  .mobile-search-trigger:active {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-primary);
  }
  .mobile-search-hint {
    margin-left: auto;
    font-size: 11px;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-glass);
    border-radius: 4px;
    padding: 2px 6px;
    line-height: 1;
    color: var(--text-secondary);
  }

  /* Mobile nav links */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background: rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }

  /* ── Responsive: switch to hamburger on narrow viewports ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .nav-search-btn {
      display: none;
    }
    .hamburger-btn {
      display: flex;
    }
  }

  /* ── Fluid headings in body content ── */
  .body-content h2 {
    font-size: clamp(1.1rem, 2vw, 1.4rem) !important;
  }
  .body-content h3 {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem) !important;
  }
  .body-content p,
  .body-content li {
    font-size: clamp(0.85rem, 1.2vw, 0.95rem) !important;
  }
</style>
