---
import SEO from "../components/SEO.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { ViewTransitions } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  /** Override OG image URL */
  image?: string;
  /** Override canonical URL */
  canonical?: string;
}

const {
  title = "SqlKraft",
  description = "SQL Server Reference Hub",
  image,
  canonical,
} = Astro.props;

// Format title with site suffix (skip suffix for homepage)
const pageTitle = title === "SqlKraft" ? title : `${title} — SqlKraft`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={pageTitle} description={description} canonicalUrl={canonical} ogImage={image} />
    <link rel="icon" type="image/svg+xml" href="/sqlkraft/favicon.svg" />
    <ViewTransitions />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem("theme");
        if (!theme) {
          theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <nav class="nav-bar">
      <div class="nav-inner">
        <a href="/sqlkraft/" class="nav-brand">SqlKraft.</a>
        <div class="nav-links">
          <a href="/sqlkraft/dmvs/">DMVs</a>
          <a href="/sqlkraft/wait-statistics/">Waits</a>
          <a href="/sqlkraft/cookbook/">Cookbook</a>
          <a href="/sqlkraft/scripts/">Scripts</a>
          <a href="/sqlkraft/xevents/">XEvents</a>
          <div class="nav-dropdown">
            <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              More
              <svg
                class="dropdown-chevron"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 3.5l3 3 3-3"></path>
              </svg>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              <a href="/sqlkraft/stored-procedures/" role="menuitem">SPs</a>
              <a href="/sqlkraft/catalog-views/" role="menuitem">Catalog</a>
              <a href="/sqlkraft/functions/" role="menuitem">Functions</a>
              <a href="/sqlkraft/errors/" role="menuitem">Errors</a>
              <a href="/sqlkraft/tsql-reference/" role="menuitem">T-SQL</a>
              <a href="/sqlkraft/architecture/" role="menuitem">Arch</a>
              <a href="/sqlkraft/operations/" role="menuitem">Ops</a>
            </div>
          </div>
        </div>
        <button id="theme-toggle" class="nav-theme-btn" aria-label="Toggle theme">
          <svg
            class="theme-icon-sun"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg
            class="theme-icon-moon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>
        <button id="search-btn" class="nav-search-btn" aria-label="Search (Ctrl+K)">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
          </svg>
          <span class="search-shortcut">Ctrl+K</span>
        </button>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="Open navigation menu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </nav>

    <!-- ── Mobile navigation drawer ── -->
    <div id="mobile-nav-drawer" class="mobile-nav-drawer">
      <div class="mobile-nav-drawer-inner">
        <button class="mobile-search-trigger" id="mobile-search-trigger">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
          </svg>
          <span>Search references</span>
          <kbd class="mobile-search-hint">Ctrl+K</kbd>
        </button>
        <button class="mobile-theme-btn" id="mobile-theme-toggle">
          <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
          <span id="mobile-theme-label">Theme</span>
        </button>
        <div class="mobile-nav-links">
          <a href="/sqlkraft/dmvs/" class="mobile-nav-link">DMVs</a>
          <a href="/sqlkraft/wait-statistics/" class="mobile-nav-link">Waits</a>
          <a href="/sqlkraft/cookbook/" class="mobile-nav-link">Cookbook</a>
          <a href="/sqlkraft/scripts/" class="mobile-nav-link">Scripts</a>
          <a href="/sqlkraft/xevents/" class="mobile-nav-link">XEvents</a>
          <a href="/sqlkraft/stored-procedures/" class="mobile-nav-link">SPs</a>
          <a href="/sqlkraft/catalog-views/" class="mobile-nav-link">Catalog</a>
          <a href="/sqlkraft/functions/" class="mobile-nav-link">Functions</a>
          <a href="/sqlkraft/errors/" class="mobile-nav-link">Errors</a>
          <a href="/sqlkraft/tsql-reference/" class="mobile-nav-link">T-SQL</a>
          <a href="/sqlkraft/architecture/" class="mobile-nav-link">Arch</a>
          <a href="/sqlkraft/operations/" class="mobile-nav-link">Ops</a>
        </div>
      </div>
    </div>
    <main id="main-content" class="app-shell">
      <slot />
    </main>
    <nav id="toc-sidebar" class="toc-sidebar" aria-label="Table of contents"></nav>
    <SearchPalette />
    <div id="link-preview-card"></div>
    <!-- ── Keyboard Shortcut Overlay ── -->
    <div id="shortcut-overlay" class="shortcut-overlay hidden">
      <div class="shortcut-backdrop"></div>
      <div class="shortcut-panel">
        <div class="shortcut-header">
          <svg
            class="shortcut-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
            <path
              d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M6 16h.01M10 16h.01M14 16h.01M18 16h.01"
            ></path>
          </svg>
          <span>Keyboard Shortcuts</span>
        </div>
        <div class="shortcut-grid">
          <div class="shortcut-row">
            <span class="shortcut-action">Search Palette</span>
            <span class="shortcut-keys"
              ><kbd class="keycap mod-key"></kbd><kbd class="keycap">K</kbd></span
            >
          </div>
          <div class="shortcut-row">
            <span class="shortcut-action">Navigate Search</span>
            <span class="shortcut-keys"><kbd class="keycap">↑</kbd><kbd class="keycap">↓</kbd></span
            >
          </div>
          <div class="shortcut-row">
            <span class="shortcut-action">Open Result</span>
            <span class="shortcut-keys"><kbd class="keycap keycap-wide">Enter</kbd></span>
          </div>
          <div class="shortcut-row">
            <span class="shortcut-action">Close Overlays</span>
            <span class="shortcut-keys"><kbd class="keycap keycap-wide">Esc</kbd></span>
          </div>
          <div class="shortcut-row">
            <span class="shortcut-action">Show Shortcuts</span>
            <span class="shortcut-keys"><kbd class="keycap">?</kbd></span>
          </div>
        </div>
        <div class="shortcut-footer">
          Press <kbd class="keycap keycap-sm">?</kbd> to toggle this menu
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  // ── Mac detection: show ⌘K instead of Ctrl+K ──
  const isMac = navigator.platform.includes("Mac");
  if (isMac) {
    const badge = document.querySelector(".search-shortcut");
    if (badge) badge.textContent = "⌘K";
    const btn = document.getElementById("search-btn");
    if (btn) btn.setAttribute("aria-label", "Search (⌘K)");
    const mobileHint = document.querySelector(".mobile-search-hint");
    if (mobileHint) mobileHint.textContent = "⌘K";
  }

  // ── Theme toggle (light / dark) ──
  (function () {
    var toggle = document.getElementById("theme-toggle");
    var mobileToggle = document.getElementById("mobile-theme-toggle");
    var mobileLabel = document.getElementById("mobile-theme-label");
    var html = document.documentElement;
    function setTheme(theme) {
      html.setAttribute("data-theme", theme);
      try { localStorage.setItem("theme", theme); } catch (e) {}
      if (mobileLabel) {
        mobileLabel.textContent = theme === "dark" ? "Dark" : "Light";
      }
    }
    function onClick() {
      var current = html.getAttribute("data-theme") || "dark";
      setTheme(current === "dark" ? "light" : "dark");
    }
    if (toggle) toggle.addEventListener("click", onClick);
    if (mobileToggle) mobileToggle.addEventListener("click", onClick);
    // Sync mobile label on load
    if (mobileLabel) {
      var current = html.getAttribute("data-theme") || "dark";
      mobileLabel.textContent = current === "dark" ? "Dark" : "Light";
    }
  })();

  // ── Mobile hamburger menu ──
  const hamburger = document.getElementById("hamburger-btn");
  const drawer = document.getElementById("mobile-nav-drawer");
  if (hamburger && drawer) {
    hamburger.addEventListener("click", () => {
      const isOpen = drawer.classList.toggle("is-active");
      hamburger.classList.toggle("is-active");
      hamburger.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu",
      );
      document.body.style.overflow = isOpen ? "hidden" : "";
    });

    // Close drawer when a nav link is tapped
    drawer.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        drawer.classList.remove("is-active");
        hamburger.classList.remove("is-active");
        hamburger.setAttribute("aria-label", "Open navigation menu");
        document.body.style.overflow = "";
      });
    });

    // Close drawer when search trigger is tapped
    const searchTrigger = document.getElementById("mobile-search-trigger");
    searchTrigger?.addEventListener("click", () => {
      drawer.classList.remove("is-active");
      hamburger.classList.remove("is-active");
      hamburger.setAttribute("aria-label", "Open navigation menu");
      document.body.style.overflow = "";
      // Open the palette
      if (window.__openPalette) window.__openPalette();
    });
  }

  // ─────────────────────────────────────────────────
  //  Link Preview Hover Cards
  // ─────────────────────────────────────────────────
  (function () {
    "use strict";

    // Only on content pages
    const hoverBody = document.querySelector(".body-content");
    if (!hoverBody) return;

    // Derive base URL from palette overlay attribute
    const hoverBaseUrl =
      document.querySelector("#palette-overlay")?.getAttribute("data-base-url") || "/sqlkraft";

    // ── Palette index (shared with search palette) ──
    let hoverIdx = null;

    function hoverInit() {
      if (
        window.__paletteIndex &&
        Array.isArray(window.__paletteIndex) &&
        window.__paletteIndex.length > 0
      ) {
        hoverIdx = window.__paletteIndex;
        return true;
      }
      return false;
    }

    // Try synchronous init; fallback fetch if not ready yet
    if (!hoverInit()) {
      fetch(hoverBaseUrl + "/data/palette-index.json")
        .then((r) => r.json())
        .then((data) => {
          hoverIdx = data;
          window.__paletteIndex = data;
        })
        .catch(() => {});
    }

    // ── Lookup palette entry by href ──
    function lookupEntry(href) {
      if (!hoverIdx || !hoverIdx.length) return null;
      let path = href;
      if (path.startsWith(hoverBaseUrl)) path = path.slice(hoverBaseUrl.length);
      // Normalise slashes for comparison
      path = path.replace(/^\/+|\/+$/g, "") || "/";

      for (const entry of hoverIdx) {
        let entryPath = (entry.u || "").replace(/^\/+|\/+$/g, "") || "/";
        if (path === entryPath) return entry;
      }
      return null;
    }

    // ── HTML escaper ──
    function escHtml(s) {
      if (!s) return "";
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // ── Hover card DOM ──
    const hoverCard = document.getElementById("link-preview-card");
    if (!hoverCard) return;

    let hoverTimer = null;
    let hoverCurrentLink = null;

    // ── Show card with edge-aware positioning ──
    function showCard(entry, rect) {
      if (!hoverCard || !entry) return;

      // Populate content first (card is opacity: 0)
      hoverCard.innerHTML =
        '<div class="lpc-title">' +
        escHtml(entry.t) +
        '</div><div class="lpc-desc">' +
        escHtml(entry.d || "") +
        '</div><div class="lpc-meta">' +
        escHtml(entry.c || "") +
        "</div>";

      // Measure height after content is set (force layout via offsetHeight)
      const cardH = hoverCard.offsetHeight || 120;
      const cardW = 320;

      // Preferred: right of the link, top-aligned
      let left = rect.right + 8;
      let top = rect.top;

      // Flip to left of the link if there's not enough room on the right
      if (left + cardW > window.innerWidth - 12) {
        left = Math.max(12, rect.left - cardW - 8);
      }
      // Prevent bottom edge overflow
      if (top + cardH > window.innerHeight - 12) {
        top = Math.max(12, window.innerHeight - cardH - 12);
      }
      // Clamp top
      if (top < 12) top = 12;
      // Clamp left
      if (left < 12) left = 12;

      hoverCard.style.left = left + "px";
      hoverCard.style.top = top + "px";

      // Force layout so position is applied before transition starts
      void hoverCard.offsetHeight;

      // Trigger entrance transition
      hoverCard.classList.add("visible");
    }

    // ── Hide card ──
    function hideCard() {
      if (!hoverCard) return;
      hoverCard.classList.remove("visible");
    }

    // ── Attach mouseenter/mouseleave to each internal link ──
    const hoverLinks = hoverBody.querySelectorAll("a");
    hoverLinks.forEach(function (link) {
      const href = link.getAttribute("href");
      // Only internal absolute links
      if (
        !href ||
        href.startsWith("http") ||
        href.startsWith("#") ||
        href.startsWith("mailto:") ||
        href.startsWith("javascript:")
      )
        return;
      if (!href.startsWith("/")) return;

      link.addEventListener("mouseenter", function () {
        hoverCurrentLink = link;
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(function () {
          if (link !== hoverCurrentLink) return;
          const entry = lookupEntry(href);
          if (!entry) return;
          const rect = link.getBoundingClientRect();
          showCard(entry, rect);
        }, 400);
      });

      link.addEventListener("mouseleave", function () {
        clearTimeout(hoverTimer);
        hideCard();
        hoverCurrentLink = null;
      });
    });

    // ── Hide on any scroll (covers page scroll, code block scroll, etc.) ──
    document.addEventListener("scroll", hideCard, { passive: true });
  })();

  // ─────────────────────────────────────────────────
  //  Keyboard Shortcut Overlay (press ?)
  // ─────────────────────────────────────────────────
  (function () {
    "use strict";

    const shortOverlay = document.getElementById("shortcut-overlay");
    if (!shortOverlay) return;

    // Set platform-specific modifier key (⌘ vs Ctrl)
    const shortIsMac = navigator.platform.includes("Mac");
    const modKeyEl = shortOverlay.querySelector(".mod-key");
    if (modKeyEl) modKeyEl.textContent = shortIsMac ? "⌘" : "Ctrl";

    function openShortcuts() {
      shortOverlay.classList.remove("hidden");
    }

    function closeShortcuts() {
      shortOverlay.classList.add("hidden");
    }

    // Global listener: ? to toggle, Escape to close
    document.addEventListener("keydown", function (e) {
      if (e.key === "?") {
        // Ignore if user is actively typing in an input/textarea
        const tag = (document.activeElement && document.activeElement.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA" || document.activeElement.isContentEditable)
          return;
        e.preventDefault();
        if (shortOverlay.classList.contains("hidden")) {
          openShortcuts();
        } else {
          closeShortcuts();
        }
      }
      if (e.key === "Escape" && !shortOverlay.classList.contains("hidden")) {
        e.preventDefault();
        closeShortcuts();
      }
    });

    // Click backdrop to close
    const shortBackdrop = shortOverlay.querySelector(".shortcut-backdrop");
    if (shortBackdrop) shortBackdrop.addEventListener("click", closeShortcuts);
  })();

  // ─────────────────────────────────────────────────
  //  Universal Copy-to-Clipboard + Sticky TOC
  // ─────────────────────────────────────────────────
  (function () {
    "use strict";

    const body = document.querySelector(".body-content");
    if (!body) return; // Only run on content pages

    /* ── 1. Copy-to-Clipboard for every <pre> block ── */
    const pres = body.querySelectorAll("pre");
    pres.forEach((pre) => {
      // Wrap pre in a relative container so copy button stays pinned
      // while code scrolls horizontally inside the pre
      const wrap = document.createElement("div");
      wrap.className = "code-wrap";
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);
      // Ensure horizontal scroll is on the pre, not the wrapper
      pre.style.overflowX = "auto";

      const btn = document.createElement("button");
      btn.className = "code-copy-btn";
      btn.innerHTML =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg><span>Copy</span>';
      btn.setAttribute("aria-label", "Copy code to clipboard");

      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        // Get the raw code text — use textContent to strip HTML
        const text = pre.textContent || "";
        try {
          await navigator.clipboard.writeText(text);
          btn.innerHTML =
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Copied!</span>';
          btn.classList.add("copied");
          setTimeout(() => {
            btn.innerHTML =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg><span>Copy</span>';
            btn.classList.remove("copied");
          }, 2000);
        } catch {
          btn.innerHTML = "<span>Failed</span>";
          setTimeout(() => {
            btn.innerHTML =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg><span>Copy</span>';
          }, 2000);
        }
      });

      wrap.appendChild(btn);
    });

    /* ── 2. Sticky Table of Contents ── */
    const toc = document.getElementById("toc-sidebar");
    if (!toc) return;

    const headings = body.querySelectorAll("h2, h3");
    if (headings.length < 2) {
      // Not enough headings to justify a TOC — leave hidden
      return;
    }

    // Ensure all headings have an id for fragment linking
    headings.forEach((h, i) => {
      if (!h.id) {
        h.id = "section-" + i;
      }
    });

    // Build TOC HTML
    let tocHTML = "<div class='toc-label'>On this page</div><ul class='toc-list'>";
    headings.forEach((h) => {
      const tag = h.tagName.toLowerCase(); // "h2" or "h3"
      const indent = tag === "h3" ? " style='--toc-indent:1'" : "";
      const text = h.textContent || "";
      tocHTML += `<li class="toc-item toc-${tag}"${indent}><a href="#${h.id}" class="toc-link">${text}</a></li>`;
    });
    tocHTML += "</ul>";
    toc.innerHTML = tocHTML;
    toc.classList.add("visible");

    // Scroll tracking via IntersectionObserver
    const tocLinks = toc.querySelectorAll(".toc-link");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              link.classList.toggle("active", link.getAttribute("href") === "#" + id);
            });
          }
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );

    headings.forEach((h) => observer.observe(h));
  })();
</script>

<style is:global>
  /* ── Theme: Dark (default) ── */
  [data-theme="dark"] {
    --bg-primary: #000000;
    --bg-secondary: #0d1117;
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --accent: #2f80ed;
    --border-glass: rgba(255, 255, 255, 0.08);
    --color-muted: #9ca3af;

    /* Alpha composites for dark */
    --alpha-surface: rgba(255, 255, 255, 0.04);
    --alpha-element: rgba(255, 255, 255, 0.06);
    --alpha-strong: rgba(255, 255, 255, 0.08);
    --alpha-hover: rgba(255, 255, 255, 0.1);
    --alpha-hover-border: rgba(255, 255, 255, 0.18);
    --alpha-text-faint: rgba(255, 255, 255, 0.25);
    --alpha-text-muted: rgba(255, 255, 255, 0.3);
    --alpha-text-label: rgba(255, 255, 255, 0.45);
    --alpha-text-bright: rgba(255, 255, 255, 0.6);
    --alpha-text-strong: rgba(255, 255, 255, 0.75);
    --alpha-overlay: rgba(22, 22, 22, 0.95);
    --alpha-drawer: rgba(13, 17, 23, 0.85);
    --alpha-dropdown: rgba(13, 17, 23, 0.75);
    --alpha-copy-bg: rgba(13, 17, 23, 0.9);
    --alpha-table-header: rgba(255, 255, 255, 0.03);
    --alpha-bg-warm: rgba(255, 255, 255, 0.05);
    --alpha-scrollbar: rgba(255, 255, 255, 0.2);
    --alpha-scrollbar-hover: rgba(255, 255, 255, 0.3);
    --alpha-toggle-bg: rgba(255, 255, 255, 0.15);

    /* Button shared */
    --btn-bg: transparent;
    --btn-border: rgba(255, 255, 255, 0.08);
    --btn-hover-border: rgba(255, 255, 255, 0.2);
    --btn-hover-bg: rgba(255, 255, 255, 0.06);
  }

  /* ── Theme: Light ── */
  [data-theme="light"] {
    --bg-primary: #ffffff;
    --bg-secondary: #f6f8fa;
    --text-primary: #1f2328;
    --text-secondary: #656d76;
    --accent: #0969da;
    --border-glass: rgba(0, 0, 0, 0.08);
    --color-muted: #6e7681;

    --alpha-surface: rgba(0, 0, 0, 0.04);
    --alpha-element: rgba(0, 0, 0, 0.06);
    --alpha-strong: rgba(0, 0, 0, 0.08);
    --alpha-hover: rgba(0, 0, 0, 0.1);
    --alpha-hover-border: rgba(0, 0, 0, 0.15);
    --alpha-text-faint: rgba(0, 0, 0, 0.2);
    --alpha-text-muted: rgba(0, 0, 0, 0.3);
    --alpha-text-label: rgba(0, 0, 0, 0.45);
    --alpha-text-bright: rgba(0, 0, 0, 0.55);
    --alpha-text-strong: rgba(0, 0, 0, 0.7);
    --alpha-overlay: rgba(240, 240, 240, 0.97);
    --alpha-drawer: rgba(255, 255, 255, 0.97);
    --alpha-dropdown: rgba(255, 255, 255, 0.95);
    --alpha-copy-bg: rgba(255, 255, 255, 0.9);
    --alpha-table-header: rgba(0, 0, 0, 0.03);
    --alpha-bg-warm: rgba(0, 0, 0, 0.02);
    --alpha-scrollbar: rgba(0, 0, 0, 0.15);
    --alpha-scrollbar-hover: rgba(0, 0, 0, 0.25);
    --alpha-toggle-bg: rgba(0, 0, 0, 0.1);

    --btn-bg: transparent;
    --btn-border: rgba(0, 0, 0, 0.1);
    --btn-hover-border: rgba(0, 0, 0, 0.2);
    --btn-hover-bg: rgba(0, 0, 0, 0.04);
  }

  :root {
    --font-sans: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "SF Mono", "Cascadia Code", Consolas, monospace;
    --max-width: 1500px;
    --nav-height: 56px;

    /* ── Fluid spacing & layout tokens ── */
    --content-max-width: min(var(--max-width), 95vw);
    --fluid-gap-sm: clamp(8px, 1vw, 16px);
    --fluid-gap-md: clamp(16px, 2vw, 28px);
    --fluid-gap-lg: clamp(24px, 3vw, 48px);
    --fluid-padding-h: clamp(20px, 3vw, 40px);
    --fluid-padding-v: clamp(24px, 3vw, 48px);

    /* ── Unified spacing rhythm ── */
    --space-xs: 0.5rem; /* 8px — h1→tagline */
    --space-sm: 0.75rem; /* 12px — tagline→subtitle */
    --space-md: 1.5rem; /* 24px — section breaks */
    --space-lg: 2.5rem; /* 40px — nav→title, subtitle→grid */
    --space-xl: 4rem; /* 64px — section top/bottom */

    /* ── Unified component tokens ── */
    --card-padding: 1.75rem; /* 28px — card inner padding on wide viewports */
    --code-padding: 1.75rem; /* 28px — code block inner padding */
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  :focus-visible {
    outline: 2px solid var(--accent, #2f80ed);
    outline-offset: 2px;
  }
  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
  }
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-glass);
    z-index: 100;
  }
  .nav-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--fluid-padding-h);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 24px);
  }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: clamp(12px, 1.2vw, 14px);
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }

  /* ── Nav Dropdown ── */
  .nav-dropdown {
    position: relative;
    display: flex;
  }
  .nav-dropdown-trigger {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: clamp(12px, 1.2vw, 14px);
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 0;
    transition: color 0.2s;
    white-space: nowrap;
    line-height: inherit;
  }
  .nav-dropdown-trigger:hover {
    color: var(--text-primary);
  }
  .dropdown-chevron {
    transition: transform 0.2s ease;
    margin-top: 1px;
  }
  .nav-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    min-width: 130px;
    background: var(--alpha-overlay);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--alpha-strong);
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 200;
    padding: 5px;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown-trigger:focus + .nav-dropdown-menu,
  .nav-dropdown-menu:hover {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .nav-dropdown-menu a {
    display: block;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .nav-dropdown-menu a:hover {
    background: var(--alpha-element);
    color: var(--text-primary);
    text-decoration: none;
  }
  .nav-search-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 200px;
    background: var(--alpha-element);
    border: 1px solid var(--border-glass);
    border-radius: 6px;
    padding: 5px 10px;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.2s,
      color 0.2s;
    margin-left: 6px;
  }
  .nav-search-btn:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
  .search-shortcut {
    font-size: 11px;
    font-family: var(--font-mono);
    background: var(--alpha-hover);
    border: 1px solid var(--border-glass);
    border-radius: 4px;
    padding: 2px 6px;
    line-height: 1;
    color: var(--text-secondary);
  }
  .app-shell {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-lg)) var(--fluid-padding-h) var(--fluid-padding-v);
  }
  a {
    color: var(--text-primary);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  /* ── Responsive tables with clean borders ── */
  .prose-content table,
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
    font-size: clamp(12px, 1.2vw, 14px);
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    border: 1px solid var(--border-glass);
    border-radius: clamp(6px, 0.8vw, 10px);
  }
  .prose-content th,
  .prose-content td,
  .body-content th,
  .body-content td {
    padding: 0.6rem 1.1rem;
    border-bottom: 1px solid var(--border-glass);
    vertical-align: top;
  }
  .prose-content th,
  .body-content th {
    text-align: left;
    background: var(--alpha-table-header);
    color: var(--text-primary);
    font-weight: 600;
  }
  .prose-content tr:last-child td,
  .body-content tr:last-child td {
    border-bottom: none;
  }
  @media (max-width: 540px) {
    .prose-content table,
    .body-content table {
      font-size: 12px;
    }
    .prose-content th,
    .prose-content td,
    .body-content th,
    .body-content td {
      padding: 6px 10px;
    }
  }

  /* ── Mobile detail page optimizations (small phones) ── */
  @media (max-width: 480px) {
    .app-shell {
      --fluid-padding-h: 24px;
    }
    .prose-content p,
    .prose-content li,
    .body-content p,
    .body-content li {
      font-size: 0.925rem !important;
    }
    .body-content pre {
      font-size: 0.9rem !important;
      padding: 14px 16px !important;
      border-radius: 10px !important;
    }
    .body-content h2 {
      font-size: 1.25rem !important;
    }
    .body-content h3 {
      font-size: 1.05rem !important;
    }
    .breadcrumb {
      font-size: 13px !important;
      gap: 6px !important;
    }
    .breadcrumb a {
      padding: 6px 0;
    }
    .detail-header {
      gap: 10px !important;
    }
    .detail-title {
      font-size: 1.3rem !important;
    }
    .tag-strip {
      gap: 6px !important;
    }
    .tag-pill {
      font-size: 12px !important;
      padding: 4px 10px !important;
    }
  }

  /* ── Fluid code blocks (1.75rem max padding) ── */
  .body-content pre {
    padding: clamp(14px, 2vw, 28px) !important;
    border-radius: clamp(8px, 1vw, 12px) !important;
    font-size: clamp(0.88rem, 1.2vw, 0.95rem) !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .body-content :not(pre) > code {
    font-size: clamp(0.8rem, 1.1vw, 0.9rem) !important;
    padding: clamp(1px, 0.3vw, 6px) clamp(3px, 0.5vw, 8px) !important;
  }

  /* ── Hamburger toggle button (hidden on desktop) ── */
  .hamburger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: 8px;
  }
  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition:
      transform 0.2s ease-out,
      opacity 0.2s ease-out;
    transform-origin: center;
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger-btn.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Mobile navigation drawer (full-screen overlay) ── */
  .mobile-nav-drawer {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    background: rgba(0, 0, 0, 0.97);
    backdrop-filter: blur(16px);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav-drawer.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mobile-nav-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--fluid-padding-h);
    max-width: 500px;
  }

  /* Mobile search trigger at top of drawer */
  .mobile-search-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: var(--space-md);
    background: var(--alpha-element);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 15px;
    cursor: pointer;
    margin-bottom: var(--space-md);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .mobile-search-trigger:hover,
  .mobile-search-trigger:active {
    border-color: var(--alpha-scrollbar);
    color: var(--text-primary);
  }
  .mobile-search-hint {
    margin-left: auto;
    font-size: 11px;
    font-family: var(--font-mono);
    background: var(--alpha-hover);
    border: 1px solid var(--border-glass);
    border-radius: 4px;
    padding: 2px 6px;
    line-height: 1;
    color: var(--text-secondary);
  }

  /* Mobile theme toggle */
  .mobile-theme-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: var(--space-md);
    background: var(--alpha-element);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 15px;
    cursor: pointer;
    margin-bottom: var(--space-sm);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .mobile-theme-btn:hover,
  .mobile-theme-btn:active {
    border-color: var(--alpha-scrollbar);
    color: var(--text-primary);
  }
  .mobile-theme-btn .theme-icon-sun,
  .mobile-theme-btn .theme-icon-moon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  #mobile-theme-label {
    flex: 1;
    text-align: left;
  }

  /* Mobile nav links */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background: var(--alpha-element);
    text-decoration: none;
  }

  /* ── Responsive: switch to hamburger on narrow viewports ── */
  @media (max-width: 850px) {
    .nav-links {
      display: none;
    }
  /* ── Theme toggle button ── */
  .nav-theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--btn-bg);
    border: 1px solid var(--btn-border);
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    margin-left: 8px;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
    flex-shrink: 0;
  }
  .nav-theme-btn:hover {
    border-color: var(--btn-hover-border);
    color: var(--text-primary);
    background: var(--btn-hover-bg);
  }
  /* Show/hide sun/moon based on theme */
  [data-theme="dark"] .theme-icon-sun { display: block; }
  [data-theme="dark"] .theme-icon-moon { display: none; }
  [data-theme="light"] .theme-icon-sun { display: none; }
  [data-theme="light"] .theme-icon-moon { display: block; }
  .theme-icon-sun,
  .theme-icon-moon {
    width: 16px;
    height: 16px;
  }

  .nav-search-btn {
      display: none;
    }
    .hamburger-btn {
      display: flex;
    }
  }

  /* ── Sticky Table of Contents (right rail) ── */
  .toc-sidebar {
    position: fixed;
    top: calc(var(--nav-height) + 32px);
    right: max(12px, calc((100vw - 1500px) / 2 - 220px));
    width: 200px;
    max-height: calc(100vh - var(--nav-height) - 64px);
    overflow-y: auto;
    display: none;
    z-index: 50;
    scrollbar-width: thin;
    scrollbar-color: var(--alpha-strong) transparent;
  }
  .toc-sidebar.visible {
    display: block;
  }
  .toc-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--alpha-text-faint);
    margin-bottom: 12px;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-item {
    margin: 0;
    padding: 0;
  }
  .toc-link {
    display: block;
    padding: 4px 0 4px 12px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--alpha-text-muted);
    text-decoration: none;
    border-left: 1px solid var(--alpha-element);
    transition:
      color 0.15s,
      border-color 0.15s;
    word-break: break-word;
  }
  .toc-link:hover {
    color: var(--alpha-text-bright);
    border-left-color: var(--alpha-scrollbar);
  }
  .toc-link.active {
    color: var(--text-primary, #e6edf3);
    border-left-color: var(--accent, #2f80ed);
  }
  .toc-h3 .toc-link {
    padding-left: 24px;
    font-size: 11px;
  }

  /* ── Code block wrapper: clips overflow so copy button stays pinned ── */
  .code-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  /* ── Code Copy Button — subtly visible, full on hover ── */
  .code-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border: 1px solid var(--alpha-strong);
    border-radius: 6px;
    background: var(--alpha-dropdown);
    color: var(--alpha-text-muted);
    font-size: 11px;
    font-family: var(--font-sans, -apple-system, sans-serif);
    cursor: pointer;
    z-index: 10;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: auto;
    line-height: 1;
  }
  .code-wrap:hover .code-copy-btn,
  .code-copy-btn:hover {
    opacity: 1;
    border-color: var(--alpha-toggle-bg);
    color: var(--alpha-text-bright);
    background: var(--alpha-copy-bg);
  }
  .code-copy-btn.copied {
    border-color: rgba(46, 160, 67, 0.5);
    color: #3fb950;
    opacity: 1;
    background: var(--alpha-copy-bg);
  }

  /* ── Responsive: hide TOC on narrow viewports ── */
  @media (max-width: 1200px) {
    .toc-sidebar {
      display: none !important;
    }
  }

  /* ── Code Block Line Numbers (CSS Counter Gutter) ── */

  /* Reset line counter on each code block */
  pre.astro-code {
    counter-reset: line;
  }

  /* Make code a column flex container so each .line is a flex row */
  pre.astro-code code {
    display: flex;
    flex-direction: column;
  }

  /* Each line is a flex row — line number (sticky) | code content */
  pre.astro-code .line {
    display: flex;
    min-height: 1.4em;
  }

  /* Line number: sticky left gutter — does NOT participate in selection */
  pre.astro-code .line::before {
    counter-increment: line;
    content: counter(line);

    /* Sticky — locks to left edge during horizontal scroll */
    position: sticky;
    left: 0;
    z-index: 2;

    /* Fixed-width gutter cell */
    flex: 0 0 auto;
    min-width: 3.4ch;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 0.75em 0 0.5em;
    margin-right: 0.75em;

    /* Gutter background matching theme */
    background: rgba(0, 0, 0, 0.15);
    border-right: 1px solid var(--alpha-bg-warm);

    /* Muted monospace typography */
    color: var(--alpha-text-faint);
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
    line-height: inherit;

    /* CRITICAL: prevent selection so only code text is copied */
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  /* ── Link Preview Hover Card ── */

  /* Card container — always in DOM, invisible by default */
  #link-preview-card {
    position: fixed;
    z-index: 9998; /* below palette (9999) but above everything else */
    width: 320px;
    max-width: min(90vw, 320px);
    padding: 14px 16px;
    background: var(--alpha-drawer);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--alpha-strong);
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    pointer-events: none; /* never block clicks on the link underneath */
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    font-family: var(--font-sans, -apple-system, sans-serif);
  }

  /* Visible state — entrance animation */
  #link-preview-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Title line */
  .lpc-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary, #e6edf3);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  /* Description line (may wrap) */
  .lpc-desc {
    font-size: 11px;
    color: var(--alpha-text-label);
    line-height: 1.4;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Category / meta label */
  .lpc-meta {
    font-size: 10px;
    color: var(--alpha-scrollbar);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

