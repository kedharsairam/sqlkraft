---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const allSps = await getCollection("stored-procedures");
const sorted = allSps.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Unique categories sorted
const categorySet = new Set(sorted.map((e) => e.data.category || "other"));
const CATEGORIES = [...categorySet].sort();
---

<BaseLayout
  title="System Stored Procedures"
  description="System stored procedures for administration, maintenance, security, and configuration."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Stored Procedures</span>
  </nav>

  <header class="page-header">
    <h1>System Stored Procedures</h1>
    <p class="page-desc">
      SQL Server system stored procedures for administrative tasks, configuration, security
      management, database maintenance, and replication.
    </p>
  </header>

  <!-- Category filter pills -->
  <div class="category-strip">
    <button class="cat-pill active" data-cat="all" onclick="filterCards('all')">All</button>
    {
      CATEGORIES.map((cat) => (
        <button class="cat-pill" data-cat={cat} onclick={`filterCards('${cat}')`}>
          {cat}
        </button>
      ))
    }
  </div>

  <!-- Unified card grid -->
  <div class="card-grid" id="spGrid">
    {
      sorted.map((entry) => {
        const { name, description, category, tags } = entry.data;
        return (
          <Card href={`/sqlkraft/stored-procedures/${entry.slug}/`} data-cat={category}>
            <span slot="title">{name}</span>
            <p slot="description">{description || "No description available."}</p>
            <div slot="tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
              {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
            </div>
          </Card>
        );
      })
    }
  </div>
</BaseLayout>

<script>
  function filterCards(category) {
    document.querySelectorAll(".cat-pill").forEach((p) => p.classList.remove("active"));
    const activePill = document.querySelector(`[data-cat="${category}"]`);
    if (activePill) activePill.classList.add("active");
    document.querySelectorAll(".item-card").forEach((card) => {
      card.style.display = category === "all" || card.dataset.cat === category ? "" : "none";
    });
  }
</script>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }

  .category-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(6px, 0.8vw, 10px);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .cat-pill {
    padding: clamp(4px, 0.6vw, 8px) clamp(10px, 1.3vw, 16px);
    border-radius: 20px;
    border: 1px solid var(--border-glass);
    background: transparent;
    color: var(--text-secondary);
    font-size: clamp(11px, 1.2vw, 14px);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .cat-pill:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }
  .cat-pill.active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }
</style>
