---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allSps = await getCollection("stored-procedures");
const sorted = allSps.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="System Stored Procedures"
  description="System stored procedures for administration, maintenance, security, and configuration."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Stored Procedures</span>
  </nav>

  <header class="page-header">
    <h1>System Stored Procedures ({sorted.length})</h1>
    <p class="page-desc">
      SQL Server system stored procedures for administrative tasks, configuration, security
      management, database maintenance, and replication.
    </p>
  </header>

  <div class="card-grid">
    {
      sorted.map((entry) => {
        const { name, description, category, tags } = entry.data;
        return (
          <a href={`/sqlkraft/stored-procedures/${entry.slug}/`} class="item-card">
            <div class="card-title">{name}</div>
            <span class="cat-badge">{category}</span>
            <p class="card-desc">
              {description ? description.slice(0, 150) : "No description available."}
            </p>
            <div class="card-tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
              {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
            </div>
          </a>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(250px, 35vw, 380px), 1fr));
    gap: clamp(10px, 1.5vw, 18px);
  }
  .item-card {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.8vw, 10px);
    padding: clamp(14px, 1.8vw, 22px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(8px, 1vw, 12px);
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card-title {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.3vw, 15px);
    font-weight: 600;
    color: var(--accent);
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(1px, 0.2vw, 3px) clamp(6px, 0.8vw, 11px);
    border-radius: 4px;
    align-self: flex-start;
    text-transform: capitalize;
  }
  .card-desc {
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(3px, 0.4vw, 6px);
    margin-top: auto;
  }
  .card-tag {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .card-tag-more {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    opacity: 0.7;
  }
</style>
