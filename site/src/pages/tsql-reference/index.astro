---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const allRefs = await getCollection("tsql-reference");
const sorted = allRefs.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Group by category
const categories = {};
for (const entry of sorted) {
  const cat = entry.data.category || "statements";
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(entry);
}

const CATEGORY_LABELS = {
  statements: "Statements",
  queries: "Queries",
  "language-elements": "Language Elements",
  "data-types": "Data Types",
  operators: "Operators",
  hints: "Hints",
  predicates: "Predicates",
  transactions: "Transactions",
  variables: "Variables",
  xquery: "XQuery",
};
---

<BaseLayout
  title="T-SQL Reference"
  description="Complete T-SQL language reference with syntax, arguments, and examples for SQL Server."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>T-SQL Reference</span>
  </nav>

  <header class="page-header">
    <h1>T-SQL Reference</h1>
    <p class="page-desc">
      SQL Server Transact-SQL language reference covering statements, queries, data types,
      operators, functions, hints, predicates, transactions, and language elements.
    </p>
  </header>

  <div class="category-nav">
    {
      Object.entries(categories)
        .sort((a, b) => b[1].length - a[1].length)
        .map(([cat, entries]) => (
          <a href={`#cat-${cat}`} class="cat-nav-item">
            <span class="cat-nav-label">{CATEGORY_LABELS[cat] || cat}</span>
          </a>
        ))
    }
  </div>

  {
    Object.entries(categories)
      .sort((a, b) => b[1].length - a[1].length)
      .map(([cat, entries]) => (
        <section id={`cat-${cat}`} class="category-section">
          <h2 class="category-heading">{CATEGORY_LABELS[cat] || cat}</h2>
          <div class="card-grid">
            {entries.map((entry) => {
              const { name, description, syntax, tags } = entry.data;
              return (
                <Card href={`/sqlkraft/tsql-reference/${entry.slug}/`}>
                  <div class="card-title">{name}</div>
                  {syntax && <div class="card-syntax">{syntax.slice(0, 200)}</div>}
                  <p class="card-desc">{description || "No description available."}</p>
                  <div class="card-tags">
                    {tags.slice(0, 3).map((tag) => (
                      <span class="card-tag">#{tag}</span>
                    ))}
                    {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
                  </div>
                </Card>
              );
            })}
          </div>
        </section>
      ))
  }
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(6px, 0.8vw, 10px);
    margin-bottom: 32px;
  }
  .cat-nav-item {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.6vw, 8px);
    padding: clamp(4px, 0.6vw, 8px) clamp(10px, 1.3vw, 16px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(8px, 1vw, 12px);
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }
  .cat-nav-item:hover {
    border-color: var(--text-secondary);
    text-decoration: none;
  }
  .cat-nav-label {
    font-size: clamp(11px, 1.2vw, 14px);
    font-weight: 500;
    color: var(--text-primary);
  }
  .category-section {
    margin-bottom: 36px;
    scroll-margin-top: 72px;
  }
  .category-heading {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-glass);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }

  .card-syntax {
    font-family: var(--font-mono);
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.3);
    padding: clamp(2px, 0.4vw, 5px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>
