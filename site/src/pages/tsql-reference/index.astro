---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allRefs = await getCollection("tsql-reference");
const sorted = allRefs.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Group by category
const categories = {};
for (const entry of sorted) {
  const cat = entry.data.category || "statements";
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(entry);
}

const CATEGORY_LABELS = {
  statements: "Statements",
  queries: "Queries",
  "language-elements": "Language Elements",
  "data-types": "Data Types",
  operators: "Operators",
  hints: "Hints",
  predicates: "Predicates",
  transactions: "Transactions",
  variables: "Variables",
  xquery: "XQuery",
};
---

<BaseLayout
  title="T-SQL Reference"
  description="Complete T-SQL language reference with syntax, arguments, and examples for SQL Server."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>T-SQL Reference</span>
  </nav>

  <header class="page-header">
    <h1>T-SQL Reference ({sorted.length})</h1>
    <p class="page-desc">
      SQL Server Transact-SQL language reference covering statements, queries, data types,
      operators, functions, hints, predicates, transactions, and language elements.
    </p>
  </header>

  <div class="category-nav">
    {
      Object.entries(categories)
        .sort((a, b) => b[1].length - a[1].length)
        .map(([cat, entries]) => (
          <a href={`#cat-${cat}`} class="cat-nav-item">
            <span class="cat-nav-label">{CATEGORY_LABELS[cat] || cat}</span>
            <span class="cat-nav-count">{entries.length}</span>
          </a>
        ))
    }
  </div>

  {
    Object.entries(categories)
      .sort((a, b) => b[1].length - a[1].length)
      .map(([cat, entries]) => (
        <section id={`cat-${cat}`} class="category-section">
          <h2 class="category-heading">
            {CATEGORY_LABELS[cat] || cat} ({entries.length})
          </h2>
          <div class="card-grid">
            {entries.map((entry) => {
              const { name, description, syntax, tags } = entry.data;
              return (
                <a href={`/sqlkraft/tsql-reference/${entry.slug}/`} class="item-card">
                  <div class="card-title">{name}</div>
                  {syntax && <div class="card-syntax">{syntax.slice(0, 100)}...</div>}
                  <p class="card-desc">
                    {description ? description.slice(0, 120) : "No description available."}
                  </p>
                  <div class="card-tags">
                    {tags.slice(0, 3).map((tag) => (
                      <span class="card-tag">#{tag}</span>
                    ))}
                    {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))
  }
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: 24px;
  }
  .page-header h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 8px;
    max-width: 700px;
    line-height: 1.6;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .cat-nav-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }
  .cat-nav-item:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .cat-nav-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .cat-nav-count {
    font-size: 11px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 7px;
    border-radius: 4px;
  }

  .category-section {
    margin-bottom: 36px;
    scroll-margin-top: 72px;
  }
  .category-heading {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-glass);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 12px;
  }
  .item-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--border-glass);
    border-radius: 10px;
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card-title {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }
  .card-syntax {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 8px;
    border-radius: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .card-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
  }
  .card-tag {
    font-size: 11px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .card-tag-more {
    font-size: 11px;
    color: var(--text-secondary);
    opacity: 0.7;
  }
</style>
