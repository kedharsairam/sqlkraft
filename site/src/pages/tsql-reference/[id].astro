---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("tsql-reference");
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, category, description, tags, syntax } = entry.data;
---

<BaseLayout title={`${name} — T-SQL Reference`} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/tsql-reference/">T-SQL Reference</a>
    <span class="sep">/</span>
    <span>{name}</span>
  </nav>

  <div class="detail-header">
    <h1 class="detail-title" transition:name={entry.slug}>{name}</h1>
    <span class="cat-badge">{category}</span>
  </div>

  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  {
    syntax && (
      <div class="syntax-block">
        <div class="syntax-label">Syntax</div>
        <pre class="syntax-code">
          <code>{syntax}</code>
        </pre>
      </div>
    )
  }

  <div class="body-content prose-content">
    <Content />
  </div>

  <nav class="detail-footer">
    <a href="/sqlkraft/tsql-reference/">&larr; Back to T-SQL Reference</a>
  </nav>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: clamp(6px, 0.8vw, 12px);
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    background: rgba(255, 255, 255, 0.06);
    color: var(--accent);
    padding: clamp(2px, 0.3vw, 5px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    text-transform: capitalize;
  }
  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .syntax-block {
    margin-bottom: clamp(16px, 2.5vw, 28px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(6px, 0.8vw, 10px);
    overflow: hidden;
  }
  .syntax-label {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    padding: clamp(6px, 0.8vw, 12px) clamp(10px, 1.5vw, 18px);
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-glass);
  }
  .syntax-code {
    background: #0d1117;
    padding: clamp(10px, 1.5vw, 18px);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.2vw, 14px);
    color: #e6edf3;
    line-height: 1.6;
    margin: 0;
  }
  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
