---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const allErrors = await getCollection("errors");
const sorted = allErrors.sort((a, b) => parseInt(a.data.name) - parseInt(b.data.name));

const SEVERITY_COLORS = {
  critical: "#e74c3c",
  high: "#ff6b6b",
  medium: "#f39c12",
  low: "#3498db",
  info: "#6272a4",
};

// Group by severity
const SEVERITY_ORDER = ["critical", "high", "medium", "low", "info"];
const grouped = {};
for (const entry of sorted) {
  const sev = entry.data.severity || "info";
  if (!grouped[sev]) grouped[sev] = [];
  grouped[sev].push(entry);
}
const severities = SEVERITY_ORDER.filter((s) => grouped[s]);
---

<BaseLayout
  title="Database Engine Errors"
  description="1,100+ SQL Server error codes with severity, category, and description."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Database Engine Errors</span>
  </nav>

  <header class="page-header">
    <h1>Database Engine Errors</h1>
    <p class="page-desc">
      SQL Server diagnostic error codes organized by severity level and category. Each error
      includes error number, severity classification, and description.
    </p>
  </header>

  <!-- Severity jump nav -->
  <nav class="section-jump">
    {
      severities.map((sev) => (
        <a href={`#sev-${sev}`} class="jump-link">
          {sev}
        </a>
      ))
    }
  </nav>

  <!-- Sectioned card grids by severity -->
  {
    severities.map((sev) => (
      <section id={`sev-${sev}`} class="category-section">
        <h2 class="section-heading">{sev}</h2>
        <div class="card-grid">
          {grouped[sev].map((entry) => {
            const { name, description, tags } = entry.data;
            const color = SEVERITY_COLORS[sev] || "#6272a4";
            return (
              <Card href={`/sqlkraft/errors/error-${name}/`}>
                <span slot="title">#{name}</span>
                <span
                  slot="meta"
                  class="severity-badge"
                  style={`background: ${color}20; color: ${color}; border-color: ${color}40;`}
                >
                  {sev}
                </span>
                <p slot="description">{description || "No description available."}</p>
                <div slot="tags">
                  {tags.slice(0, 3).map((tag) => (
                    <span class="card-tag">#{tag}</span>
                  ))}
                  {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
                </div>
              </Card>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }
  /* ── Section jump nav ── */
  .section-jump {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .jump-link {
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--text-secondary);
    padding: clamp(3px, 0.4vw, 6px) clamp(8px, 1vw, 14px);
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .jump-link:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
    text-decoration: none;
  }
  .category-section {
    margin-bottom: clamp(20px, 3vw, 36px);
    scroll-margin-top: 72px;
  }
  .section-heading {
    font-size: clamp(13px, 1.3vw, 16px);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: clamp(8px, 1vw, 14px);
    padding-bottom: clamp(4px, 0.5vw, 8px);
    border-bottom: 1px solid var(--border-glass);
    text-transform: capitalize;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }
  .severity-badge {
    font-size: clamp(9px, 1vw, 11px);
    font-weight: 600;
    text-transform: uppercase;
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
</style>
