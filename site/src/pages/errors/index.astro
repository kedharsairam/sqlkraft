---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allErrors = await getCollection("errors");
const sorted = allErrors.sort((a, b) => parseInt(a.data.name) - parseInt(b.data.name));

const SEVERITY_COLORS = {
  critical: "#e74c3c",
  high: "#ff6b6b",
  medium: "#f39c12",
  low: "#3498db",
  info: "#6272a4",
};
---

<BaseLayout
  title="Database Engine Errors"
  description="1,100+ SQL Server error codes with severity, category, and description."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Database Engine Errors</span>
  </nav>

  <header class="page-header">
    <h1>Database Engine Errors ({sorted.length})</h1>
    <p class="page-desc">
      SQL Server diagnostic error codes organized by severity level and category. Each error
      includes error number, severity classification, and description.
    </p>
  </header>

  <div class="card-grid">
    {
      sorted.map((entry) => {
        const { name, title, errorNumber, severity, category, description, tags } = entry.data;
        const color = SEVERITY_COLORS[severity] || "#6272a4";
        return (
          <a href={`/sqlkraft/errors/error-${name}/`} class="item-card">
            <div class="card-header">
              <span class="error-number">#{name}</span>
              <span
                class="severity-badge"
                style={`background: ${color}20; color: ${color}; border-color: ${color}40;`}
              >
                {severity}
              </span>
            </div>
            <span class="cat-badge">{category}</span>
            <p class="card-desc">
              {description ? description.slice(0, 150) : "No description available."}
            </p>
            <div class="card-tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
              {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
            </div>
          </a>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(250px, 35vw, 380px), 1fr));
    gap: clamp(10px, 1.5vw, 18px);
  }
  .item-card {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.8vw, 10px);
    padding: clamp(14px, 1.8vw, 22px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(8px, 1vw, 12px);
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(4px, 0.8vw, 10px);
  }
  .error-number {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.3vw, 15px);
    font-weight: 600;
    color: var(--text-primary);
  }
  .severity-badge {
    font-size: clamp(9px, 1vw, 11px);
    font-weight: 600;
    text-transform: uppercase;
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(1px, 0.2vw, 3px) clamp(6px, 0.8vw, 11px);
    border-radius: 4px;
    align-self: flex-start;
    text-transform: capitalize;
  }
  .card-desc {
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(3px, 0.4vw, 6px);
    margin-top: auto;
  }
  .card-tag {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .card-tag-more {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    opacity: 0.7;
  }
</style>
