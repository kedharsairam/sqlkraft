---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("errors");
  return entries.map((entry) => ({
    params: { id: `error-${entry.data.name}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, errorNumber, severity, category, description, tags } = entry.data;

const SEVERITY_COLORS = {
  critical: "#e74c3c",
  high: "#ff6b6b",
  medium: "#f39c12",
  low: "#3498db",
  info: "#6272a4",
};
const sevColor = SEVERITY_COLORS[severity] || "#6272a4";
---

<BaseLayout title={title} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/errors/">Errors</a>
    <span class="sep">/</span>
    <span>{title}</span>
  </nav>

  <div class="detail-header">
    <h1 class="detail-title">
      <span class="error-num">#{name}</span>
      <span class="title-text">{title}</span>
    </h1>
    <div class="badge-strip">
      <span
        class="badge sev-badge"
        style={`background: ${sevColor}20; color: ${sevColor}; border-color: ${sevColor}40;`}
      >
        {severity.toUpperCase()}
      </span>
      <span class="badge cat-pill">{category}</span>
    </div>
  </div>

  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  <div class="body-content">
    <Content />
  </div>

  <nav class="detail-footer">
    <a href="/sqlkraft/errors/">&larr; Back to all errors</a>
  </nav>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: clamp(6px, 0.8vw, 12px);
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    flex-wrap: wrap;
  }
  .error-num {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .title-text {
    color: var(--text-primary);
  }
  .badge-strip {
    display: flex;
    gap: clamp(4px, 0.8vw, 10px);
    flex-wrap: wrap;
  }
  .badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 600;
    padding: clamp(2px, 0.3vw, 5px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .sev-badge {
    border: 1px solid;
  }
  .cat-pill {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
  }
  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
