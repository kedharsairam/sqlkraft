---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allFns = await getCollection("functions");
const sorted = allFns.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="System Functions"
  description="Built-in system functions for SQL Server with syntax, arguments, and examples."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>System Functions</span>
  </nav>

  <header class="page-header">
    <h1>System Functions ({sorted.length})</h1>
    <p class="page-desc">
      SQL Server built-in system functions organized by category — aggregate, analytic, conversion,
      cryptographic, date/time, mathematical, metadata, ranking, security, string, and more.
    </p>
  </header>

  <div class="card-grid">
    {
      sorted.map((entry) => {
        const { name, description, category, returnType, tags } = entry.data;
        return (
          <a href={`/sqlkraft/functions/${entry.slug}/`} class="item-card">
            <div class="card-header">
              <span class="fn-name">{name}</span>
              {returnType && <span class="return-badge">{returnType}</span>}
            </div>
            <span class="cat-badge">{category}</span>
            <p class="card-desc">
              {description ? description.slice(0, 150) : "No description available."}
            </p>
            <div class="card-tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
              {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
            </div>
          </a>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: 24px;
  }
  .page-header h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 8px;
    max-width: 700px;
    line-height: 1.6;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 14px;
  }
  .item-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--border-glass);
    border-radius: 10px;
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .fn-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }
  .return-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    background: rgba(46, 204, 113, 0.15);
    color: #2ecc71;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .cat-badge {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 10px;
    border-radius: 4px;
    align-self: flex-start;
    text-transform: capitalize;
  }
  .card-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
  }
  .card-tag {
    font-size: 11px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .card-tag-more {
    font-size: 11px;
    color: var(--text-secondary);
    opacity: 0.7;
  }
</style>
