---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const allScripts = await getCollection("scripts");
const sorted = allScripts.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Human-readable category labels
const CATEGORY_LABELS = {
  architecture: "Architecture",
  automation: "Automation",
  "backup-restore": "Backup & Restore",
  database: "Database",
  general: "General",
  "high-availability": "High Availability",
  "index-maintenance": "Index Maintenance",
  installation: "Installation",
  migration: "Migration",
  performance: "Performance",
  replication: "Replication",
  "security-audit": "Security & Audit",
  troubleshooting: "Troubleshooting",
};

const scriptsData = sorted;
---

<BaseLayout
  title="TSQL Scripts & Snippets"
  description="Diagnostic scripts and snippets for SQL Server performance troubleshooting."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Scripts</span>
  </nav>

  <header class="page-header">
    <h1>TSQL Scripts & Snippets</h1>
    <p class="page-desc">
      Reusable diagnostic and administrative scripts covering wait statistics analysis, DMV queries,
      index maintenance, blocking chains, memory pressure, and more.
    </p>
  </header>

  <!-- Card Grid -->
  <div class="card-grid" id="card-grid">
    {
      scriptsData.map((s) => (
        <Card href={`/sqlkraft/scripts/${s.slug}/`}>
          <span slot="title">{s.data.name}</span>
          <span slot="meta" class="cat-badge">
            {CATEGORY_LABELS[s.data.category] || s.data.category}
          </span>
          <p slot="description">{s.data.description || "No description available."}</p>
          <div slot="tags">
            {s.data.tags.slice(0, 4).map((tag) => (
              <span class="card-tag">#{tag}</span>
            ))}
            {s.data.tags.length > 4 && (
              <span class="card-tag-more">+{s.data.tags.length - 4} more</span>
            )}
          </div>
        </Card>
      ))
    }
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }

  /* ── Card Grid ── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(1px, 0.2vw, 3px) clamp(6px, 0.8vw, 11px);
    border-radius: 4px;
    text-transform: capitalize;
  }
</style>
