---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("scripts");
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, category, description, tags } = entry.data;
---

<BaseLayout title={`${name} — TSQL Script`} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/scripts/">Scripts</a>
    <span class="sep">/</span>
    <span>{name}</span>
  </nav>

  <div class="detail-header">
    <h1 class="detail-title">{name}</h1>
    <span class="cat-badge">{category}</span>
  </div>

  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  <div class="body-content prose-content">
    <Content />
  </div>

  <nav class="detail-footer">
    <a href="/sqlkraft/scripts/">&larr; Back to all scripts</a>
  </nav>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: clamp(6px, 0.8vw, 12px);
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    text-transform: capitalize;
  }
  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .body-content h2 {
    color: var(--text-primary);
    margin: clamp(20px, 3vw, 36px) 0 clamp(8px, 1vw, 14px);
    font-weight: 600;
  }
  .body-content h3 {
    color: var(--text-primary);
    margin: clamp(16px, 2.5vw, 28px) 0 clamp(6px, 0.8vw, 12px);
    font-weight: 600;
  }
  .body-content p {
    margin-bottom: clamp(10px, 1.2vw, 16px);
  }
  .body-content ul,
  .body-content ol {
    margin-bottom: clamp(10px, 1.2vw, 16px);
    padding-left: clamp(16px, 2vw, 24px);
  }
  .body-content li {
    margin-bottom: clamp(4px, 0.5vw, 8px);
  }
  .body-content pre {
    background: #0d1117;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: clamp(12px, 1.5vw, 20px);
    margin-top: clamp(20px, 3vw, 36px);
  }
  .body-content code {
    font-family: var(--font-mono);
    color: #e6edf3;
  }
  .body-content :not(pre) > code {
    color: #e6edf3;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
  }
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: clamp(12px, 1.5vw, 20px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(4px, 0.5vw, 8px);
    overflow: hidden;
  }
  .body-content th {
    text-align: left;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-glass);
  }
  .body-content td {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border-glass);
    vertical-align: top;
  }
  .body-content tr:last-child td {
    border-bottom: none;
  }
  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
