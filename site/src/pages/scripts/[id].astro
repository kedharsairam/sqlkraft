---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("scripts");
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, category, description, tags } = entry.data;
---

<BaseLayout title={`${name} — TSQL Script`} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/scripts/">Scripts</a>
    <span class="sep">/</span>
    <span>{name}</span>
  </nav>

  <div class="detail-header">
    <h1 class="detail-title">{name}</h1>
    <span class="cat-badge">{category}</span>
  </div>

  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  <div class="body-content" id="body-content">
    <button class="copy-btn" id="copy-btn" title="Copy SQL to clipboard">
      <span class="copy-label" id="copy-label">Copy SQL</span>
      <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
      </svg>
    </button>
    <Content />
  </div>

  <nav class="detail-footer">
    <a href="/sqlkraft/scripts/">&larr; Back to all scripts</a>
  </nav>
</BaseLayout>

<script>
  const copyBtn = document.getElementById("copy-btn");
  const copyLabel = document.getElementById("copy-label");
  const bodyContent = document.getElementById("body-content");

  copyBtn.addEventListener("click", async () => {
    const pre = bodyContent.querySelector("pre");
    if (!pre) return;
    try {
      const text = pre.textContent || "";
      await navigator.clipboard.writeText(text);
      copyLabel.textContent = "Copied!";
      copyBtn.classList.add("copied");
      setTimeout(() => {
        copyLabel.textContent = "Copy SQL";
        copyBtn.classList.remove("copied");
      }, 2000);
    } catch {
      copyLabel.textContent = "Copy failed";
      setTimeout(() => {
        copyLabel.textContent = "Copy SQL";
      }, 2000);
    }
  });
</script>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: 24px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .cat-badge {
    font-size: 11px;
    font-weight: 500;
    background: rgba(47, 128, 237, 0.12);
    color: var(--accent);
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: capitalize;
  }
  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .tag-pill {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 10px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  /* ── Body Content (with copy button) ── */
  .body-content {
    position: relative;
    line-height: 1.8;
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* Floating Copy Button */
  .copy-btn {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--border-glass);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
    z-index: 10;
    transition: all 0.15s;
  }
  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .copy-btn.copied {
    border-color: #2ea043;
    color: #2ea043;
  }
  .copy-label {
    white-space: nowrap;
  }
  .copy-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .body-content h2 {
    font-size: 20px;
    color: var(--text-primary);
    margin: 32px 0 12px;
    font-weight: 600;
  }
  .body-content h3 {
    font-size: 16px;
    color: var(--text-primary);
    margin: 24px 0 10px;
    font-weight: 600;
  }
  .body-content p {
    margin-bottom: 14px;
  }
  .body-content ul,
  .body-content ol {
    margin-bottom: 14px;
    padding-left: 20px;
  }
  .body-content li {
    margin-bottom: 6px;
  }
  .body-content pre {
    background: #0d1117;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 16px;
    margin-top: 32px;
  }
  .body-content code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #e6edf3;
  }
  .body-content :not(pre) > code {
    color: var(--accent);
    background: rgba(47, 128, 237, 0.1);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
    font-size: 13px;
  }
  .body-content th {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid var(--border-glass);
    color: var(--text-primary);
    font-weight: 600;
  }
  .body-content td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-glass);
  }
  .detail-footer {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--border-glass);
    font-size: 13px;
  }
  .detail-footer a {
    color: var(--accent);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
