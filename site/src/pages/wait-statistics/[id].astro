---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const waits = await getCollection("wait-statistics");
  return waits.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, category, severity, description, tags, relatedScripts } = entry.data;

const CATEGORY_META = {
  baseline: { label: "Baseline", color: "#6272a4" },
  triage: { label: "Triage", color: "#e74c3c" },
  "top-consumer": { label: "Top Consumer", color: "#ff6b6b" },
  latency: { label: "Latency", color: "#f39c12" },
  blocking: { label: "Blocking", color: "#e74c3c" },
  memory: { label: "Memory", color: "#9b59b6" },
  scheduling: { label: "Scheduling", color: "#3498db" },
  io: { label: "I/O", color: "#2ecc71" },
};

const SEVERITY_COLORS = {
  critical: "#e74c3c",
  high: "#ff6b6b",
  medium: "#f39c12",
  low: "#3498db",
  info: "#6272a4",
};

const catMeta = CATEGORY_META[category] || { label: "Unknown", color: "#6272a4" };
const sevColor = SEVERITY_COLORS[severity] || "#6272a4";
---

<BaseLayout title={`${name} — Wait Statistics`} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/wait-statistics/">Wait Statistics</a>
    <span class="sep">/</span>
    <span>{name}</span>
  </nav>

  <!-- Header strip -->
  <div class="detail-header">
    <h1 class="detail-title">
      <span class="wait-name">{name}</span>
    </h1>
    <div class="badge-strip">
      <span
        class="badge severity-badge"
        style={`background: ${sevColor}20; color: ${sevColor}; border-color: ${sevColor}40;`}
      >
        {severity.toUpperCase()}
      </span>
      <span
        class="badge cat-badge"
        style={`background: ${catMeta.color}20; color: ${catMeta.color};`}
      >
        {catMeta.label}
      </span>
    </div>
  </div>

  <!-- Tags -->
  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  <!-- Related scripts -->
  {
    relatedScripts && relatedScripts.length > 0 && (
      <div class="scripts-callout">
        <strong>Related diagnostic scripts:</strong>
        <div class="script-links">
          {relatedScripts.map((s) => (
            <a href={`/sqlkraft/scripts/#${s}`} class="script-link">
              {s}
            </a>
          ))}
        </div>
      </div>
    )
  }

  <!-- Body content -->
  <div class="body-content">
    <Content />
  </div>

  <nav class="detail-footer">
    <a href="/sqlkraft/wait-statistics/">&larr; Back to Wait Statistics</a>
  </nav>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(8px, 1.5vw, 18px);
    margin-bottom: clamp(8px, 1vw, 14px);
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
  }
  .wait-name {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }
  .badge-strip {
    display: flex;
    gap: clamp(4px, 0.8vw, 10px);
    flex-wrap: wrap;
  }
  .badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 600;
    padding: clamp(2px, 0.3vw, 5px) clamp(8px, 1vw, 14px);
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .severity-badge {
    border: 1px solid;
  }

  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  /* ── Diagnostic section panels ── */
  .body-content h2 {
    margin: clamp(24px, 3.5vw, 40px) 0 clamp(10px, 1.2vw, 16px);
    padding: clamp(8px, 1vw, 14px) clamp(12px, 1.5vw, 20px);
    border-left: 3px solid var(--border-glass);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0 clamp(4px, 0.5vw, 8px) clamp(4px, 0.5vw, 8px) 0;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--text-primary);
    font-weight: 600;
  }
  /* Overview section — cool left border */
  .body-content h2#overview {
    border-left-color: #58a6ff;
  }
  /* Troubleshooting / Diagnostics — warm left border */
  .body-content h2#troubleshooting,
  .body-content h2#diagnostic-mechanics {
    border-left-color: #d29922;
  }
  /* See Also — muted left border, transparent bg */
  .body-content h2#see-also {
    border-left-color: var(--border-glass);
    background: transparent;
  }

  /* ── Compact border-muted tables (Key Metrics) ── */
  .body-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: clamp(12px, 1.5vw, 20px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(4px, 0.5vw, 8px);
    overflow: hidden;
  }
  .body-content th {
    text-align: left;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-glass);
  }
  .body-content td {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border-glass);
    vertical-align: top;
  }
  .body-content tr:last-child td {
    border-bottom: none;
  }

  .scripts-callout {
    padding: clamp(10px, 1.5vw, 18px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(6px, 0.8vw, 10px);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: clamp(16px, 2.5vw, 28px);
    font-size: clamp(12px, 1.2vw, 14px);
    color: var(--text-secondary);
  }
  .scripts-callout strong {
    color: var(--text-primary);
    display: block;
    margin-bottom: clamp(6px, 0.8vw, 10px);
  }
  .script-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.8vw, 10px);
  }
  .script-link {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    text-decoration: none;
    padding: clamp(1px, 0.2vw, 3px) clamp(6px, 0.7vw, 10px);
    border: 1px solid var(--border-glass);
    border-radius: 4px;
    transition: border-color 0.2s;
  }
  .script-link:hover {
    background: rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }

  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
