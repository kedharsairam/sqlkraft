---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("operations");
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, topic, description, tags } = entry.data;
---

<BaseLayout
  title={`${title} — Operations Guide`}
  description={description || `SQL Server operations guide: ${title}`}
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/operations/">Operations</a>
    <span class="sep">/</span>
    <span>{title}</span>
  </nav>

  <article class="ops-detail">
    <header class="detail-header">
      <div class="meta-row">
        <span class="topic-badge">{topic.replace(/-/g, " ")}</span>
        <div class="tag-strip">
          {tags.slice(0, 4).map((tag) => <span class="tag-pill">#{tag}</span>)}
        </div>
      </div>
      <h1 class="detail-title" transition:name={entry.slug}>{title}</h1>
      {description && <p class="detail-desc">{description}</p>}
    </header>

    <div class="body-content prose-content">
      <Content />
    </div>

    <footer class="detail-footer">
      <a href="/sqlkraft/operations/">&larr; Back to operations</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }

  .ops-detail {
    max-width: 900px;
  }

  .detail-header {
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: clamp(6px, 0.8vw, 12px);
    flex-wrap: wrap;
  }

  .topic-badge {
    display: inline-block;
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: clamp(2px, 0.3vw, 5px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
  }

  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .detail-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 8px;
    line-height: 1.6;
  }

  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
  }

  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
