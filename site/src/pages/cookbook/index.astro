---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const allRecipes = await getCollection("cookbook");
const sorted = allRecipes.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Unique categories sorted
const categorySet = new Set(sorted.map((e) => e.data.category || "general"));
const CATEGORIES = [...categorySet].sort();

// Human-readable labels
const CATEGORY_LABELS = {
  performance: "Performance Triage",
  blocking: "Blocking & Concurrency",
  memory: "Memory Management",
  io: "I/O & Storage",
  availability: "High Availability",
  general: "General Troubleshooting",
};

const SEVERITY_ORDER = { critical: 0, high: 1, medium: 2, low: 3, info: 4 };
function severityScore(s) {
  return SEVERITY_ORDER[s] ?? 99;
}

// Sort globally by severity (critical → info), then by name
const globallySorted = [...sorted].sort((a, b) => {
  const sa = severityScore(a.data.severity);
  const sb = severityScore(b.data.severity);
  return sa - sb || a.data.name.localeCompare(b.data.name);
});
---

<BaseLayout
  title="Troubleshooting Cookbook"
  description="Cross-collection diagnostic guides linking DMVs, wait statistics, scripts, and error codes into unified troubleshooting scenarios."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Cookbook</span>
  </nav>

  <header class="page-header">
    <h1>Troubleshooting Cookbook</h1>
    <p class="page-desc">
      Scenario-based diagnostic guides that cross-reference DMVs, wait statistics, T-SQL scripts,
      and error codes into unified troubleshooting workflows. Each recipe walks through a common
      database emergency from symptom identification through resolution.
    </p>
  </header>

  <!-- Category filter pills -->
  <div class="category-strip">
    <button class="cat-pill active" data-cat="all" onclick="filterCards('all')">All</button>
    {
      CATEGORIES.map((cat) => (
        <button class="cat-pill" data-cat={cat} onclick={`filterCards('${cat}')`}>
          {CATEGORY_LABELS[cat] || cat}
        </button>
      ))
    }
  </div>

  <!-- Unified card grid -->
  <div class="card-grid" id="recipeGrid">
    {
      globallySorted.map((entry) => {
        const { name, description, severity, category, tags } = entry.data;
        const sev = severity || "medium";
        return (
          <Card href={`/sqlkraft/cookbook/${entry.slug}/`} data-cat={category}>
            <span slot="title">{name}</span>
            <span slot="meta" class={`sev-badge sev-${sev}`}>
              {sev}
            </span>
            <p slot="description">{description || "No description available."}</p>
            <div slot="tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
              {tags.length > 3 && <span class="card-tag-more">+{tags.length - 3} more</span>}
            </div>
          </Card>
        );
      })
    }
  </div>
</BaseLayout>

<script>
  function filterCards(category) {
    document.querySelectorAll(".cat-pill").forEach((p) => p.classList.remove("active"));
    const activePill = document.querySelector(`[data-cat="${category}"]`);
    if (activePill) activePill.classList.add("active");
    document.querySelectorAll(".item-card").forEach((card) => {
      card.style.display = category === "all" || card.dataset.cat === category ? "" : "none";
    });
  }
</script>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
  }
  .page-desc {
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 800px;
  }

  .category-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(6px, 0.8vw, 10px);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .cat-pill {
    padding: clamp(4px, 0.6vw, 8px) clamp(10px, 1.3vw, 16px);
    border-radius: 20px;
    border: 1px solid var(--border-glass);
    background: transparent;
    color: var(--text-secondary);
    font-size: clamp(11px, 1.2vw, 14px);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .cat-pill:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }
  .cat-pill.active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }

  /* ── Severity badges ── */
  .sev-badge {
    font-size: clamp(9px, 0.9vw, 11px);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    flex-shrink: 0;
  }
  .sev-critical {
    color: #f85149;
    background: rgba(248, 81, 73, 0.12);
  }
  .sev-high {
    color: #d29922;
    background: rgba(210, 153, 34, 0.12);
  }
  .sev-medium {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.06);
  }
  .sev-low {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.04);
    opacity: 0.7;
  }
  .sev-info {
    color: #58a6ff;
    background: rgba(88, 166, 255, 0.08);
  }
</style>
