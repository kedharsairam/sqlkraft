---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeLayout from "../../layouts/RecipeLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("cookbook");
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name, title, category, severity, description, tags, relatedContent, related } = entry.data;
const sev = severity || "medium";
---

<BaseLayout title={`${name} — Troubleshooting Guide`} description={description}>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <a href="/sqlkraft/cookbook/">Cookbook</a>
    <span class="sep">/</span>
    <span>{name}</span>
  </nav>

  <div class="detail-header">
    <h1 class="detail-title" transition:name={entry.slug}>{name}</h1>
    <span class="cat-badge">{category}</span>
    <span class={`sev-badge sev-${sev}`}>{sev}</span>
  </div>

  <div class="tag-strip">
    {tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
  </div>

  <RecipeLayout title={title} description={description} relatedContent={relatedContent}>
    <div class="body-content prose-content">
      <Content />
    </div>
  </RecipeLayout>

  <RelatedLinks related={related} />

  <nav class="detail-footer">
    <a href="/sqlkraft/cookbook/">&larr; Back to cookbook</a>
  </nav>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: clamp(6px, 0.8vw, 12px);
    flex-wrap: wrap;
  }
  .detail-title {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .cat-badge {
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 500;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    text-transform: capitalize;
  }
  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }
  .tag-pill {
    font-size: clamp(11px, 1vw, 13px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(2px, 0.3vw, 4px) clamp(6px, 0.8vw, 12px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .body-content {
    line-height: 1.8;
    color: var(--text-secondary);
  }

  /* ── Severity badge ── */
  .sev-badge {
    font-size: clamp(9px, 0.9vw, 11px);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .sev-critical {
    color: #f85149;
    background: rgba(248, 81, 73, 0.12);
  }
  .sev-high {
    color: #d29922;
    background: rgba(210, 153, 34, 0.12);
  }
  .sev-medium {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.06);
  }
  .sev-low {
    color: #8b949e;
    background: rgba(255, 255, 255, 0.04);
    opacity: 0.7;
  }
  .sev-info {
    color: #58a6ff;
    background: rgba(88, 166, 255, 0.08);
  }
  .detail-footer {
    margin-top: clamp(24px, 4vw, 48px);
    padding-top: clamp(12px, 1.5vw, 20px);
    border-top: 1px solid var(--border-glass);
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .detail-footer a:hover {
    text-decoration: underline;
  }
</style>
