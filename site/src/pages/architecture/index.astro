---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArch = await getCollection("architecture");
const sorted = allArch.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Database Engine Architecture"
  description="Deep technical guides on SQL Server internals — query processing, memory management, locking, I/O, and more."
>
  <nav class="breadcrumb">
    <a href="/sqlkraft/">&larr; Home</a>
    <span class="sep">/</span>
    <span>Architecture & Internals</span>
  </nav>

  <header class="page-header">
    <h1>Architecture &amp; Internals</h1>
    <p class="page-desc">
      In-depth technical narratives covering SQL Server's internal architecture — query processing,
      index structures, memory management, locking and deadlocking, thread and task scheduling, I/O
      fundamentals, and transaction log architecture.
    </p>
  </header>

  <div class="topic-sections">
    {
      [
        "query-processing",
        "index-architecture",
        "memory-management",
        "locking",
        "deadlocks",
        "thread-task",
        "io-fundamentals",
        "transaction-log",
        "latch-contention",
        "spinlock-contention",
        "collation",
        "tables",
        "change-data-capture",
        "clr-integration",
        "xml-data",
        "json-data",
        "spatial-data",
        "sql-graph",
        "filestream",
        "service-broker",
        "hierarchical-data",
      ].map((topic) => {
        const entries = sorted.filter((e) => e.data.topic === topic);
        if (entries.length === 0) return null;
        return (
          <div class="topic-block">
            <h2 class="topic-title">
              {topic.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())}
            </h2>
            <div class="arch-card-grid">
              {entries.map((entry) => {
                const { title, description, tags } = entry.data;
                return (
                  <a href={`/sqlkraft/architecture/${entry.slug}/`} class="arch-card">
                    <div class="card-title">{title}</div>
                    <p class="card-desc">{description || "No description available."}</p>
                    <div class="card-tags">
                      {tags.slice(0, 2).map((tag) => (
                        <span class="card-tag">#{tag}</span>
                      ))}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.8vw, 10px);
    font-size: clamp(11px, 1.2vw, 14px);
    color: var(--text-secondary);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--border-glass);
  }
  .page-header {
    margin-bottom: clamp(12px, 2.5vw, 28px);
  }
  .page-header h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .page-desc {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    color: var(--text-secondary);
    margin-top: clamp(6px, 0.8vw, 10px);
    max-width: min(700px, 90vw);
    line-height: 1.6;
  }
  .topic-sections {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .topic-block {
  }
  .topic-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-glass);
  }
  .arch-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(240px, 18vw, 320px), 1fr));
    gap: clamp(8px, 1vw, 14px);
  }
  .arch-card {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.8vw, 10px);
    padding: clamp(14px, 1.8vw, 28px);
    border: 1px solid var(--border-glass);
    border-radius: clamp(8px, 1vw, 12px);
    background: var(--bg-secondary);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }
  .arch-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .card-title {
    font-size: clamp(12px, 1.3vw, 15px);
    font-weight: 600;
    color: var(--text-primary);
  }
  .card-desc {
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(3px, 0.4vw, 6px);
    margin-top: auto;
  }
  .card-tag {
    font-size: clamp(10px, 1vw, 12px);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: clamp(1px, 0.2vw, 3px) clamp(5px, 0.7vw, 9px);
    border-radius: 4px;
    font-family: var(--font-mono);
  }
</style>
