---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="SqlKraft"
  description="Enterprise SQL Server reference hub — DMVs, wait statistics, T-SQL reference, system catalog views, and architecture documentation."
>
  <section class="hero">
    <h1>SqlKraft.</h1>
    <p class="tagline">Enterprise SQL Server Reference Hub</p>
    <p class="subtitle">
      Curated, high-performance static encyclopedia for the DBA community. DMVs, wait statistics,
      T-SQL reference, catalog views, system functions, stored procedures, architecture, operations,
      and diagnostic scripts.
    </p>
  </section>

  <section class="portal-grid">
    <a href="/sqlkraft/dmvs/" class="portal-card">
      <h2>Dynamic Management Views</h2>
      <p>160+ DMVs across execution, I/O, memory, indexing, transactions, and OS internals.</p>
    </a>
    <a href="/sqlkraft/wait-statistics/" class="portal-card">
      <h2>Wait Statistics</h2>
      <p>
        50+ wait types categorized by severity — baseline, triage, top-consumer, blocking, and more.
      </p>
    </a>
    <a href="/sqlkraft/catalog-views/" class="portal-card">
      <h2>System Catalog Views</h2>
      <p>
        150+ catalog views — databases, objects, security, indexes, partitions, and configuration.
      </p>
    </a>
    <a href="/sqlkraft/functions/" class="portal-card">
      <h2>System Functions</h2>
      <p>
        All built-in functions — aggregate, analytic, conversion, string, date/time, system, and
        JSON.
      </p>
    </a>
    <a href="/sqlkraft/tsql-reference/" class="portal-card">
      <h2>T-SQL Reference</h2>
      <p>
        Complete language reference — statements, queries, data types, operators, hints, and
        predicates.
      </p>
    </a>
    <a href="/sqlkraft/errors/" class="portal-card">
      <h2>Error Codes</h2>
      <p>Database Engine error codes with severity, message text, and troubleshooting guidance.</p>
    </a>
    <a href="/sqlkraft/architecture/" class="portal-card">
      <h2>Architecture</h2>
      <p>
        Engine internals — query processing, memory management, locking, threading, and I/O
        fundamentals.
      </p>
    </a>
    <a href="/sqlkraft/stored-procedures/" class="portal-card">
      <h2>System Stored Procedures</h2>
      <p>
        System stored procedures for administration, configuration, maintenance, and automation.
      </p>
    </a>
    <a href="/sqlkraft/operations/" class="portal-card">
      <h2>Operations & Administration</h2>
      <p>
        Operational guides — SSMS, Profiler, SQLPackage, Linux, migration, monitoring, HA, and
        configuration.
      </p>
    </a>
    <a href="/sqlkraft/scripts/" class="portal-card">
      <h2>TSQL Diagnostic Scripts</h2>
      <p>
        270+ curated diagnostic and administrative scripts — indexing, performance, security,
        backup-restore, high-availability, and more.
      </p>
    </a>
  </section>

  <footer class="footer">
    <p>SqlKraft v0.5.0 — Curated enterprise DBA reference.</p>
    <p>Open source. MIT licensed. <a href="https://github.com/kedharsairam/sqlkraft">GitHub</a></p>
  </footer>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    text-align: center;
    padding: 72px 0 0;
  }
  .hero h1 {
    font-size: 48px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -1px;
  }
  .tagline {
    font-size: 20px;
    color: var(--text-primary);
    margin-top: 10px;
    font-weight: 500;
  }
  .subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 65ch;
    margin: 18px auto 3.5rem;
    line-height: 1.7;
    padding: 0 16px;
  }

  /* ── Portal Grid (flex for centered trailing row) ── */
  .portal-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem;
  }
  .portal-card {
    flex: 0 0 300px;
    display: block;
    padding: 28px 24px 26px;
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    background: var(--bg-secondary);
    transition:
      border-color 0.2s,
      transform 0.2s;
    text-decoration: none;
    color: inherit;
  }
  .portal-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    text-decoration: none;
  }
  .portal-card h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--text-primary);
  }
  .portal-card p {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* ── Footer ── */
  .footer {
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--border-glass);
    text-align: center;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.8;
  }

  /* ── Responsive: single column on narrow screens ── */
  @media (max-width: 680px) {
    .hero h1 {
      font-size: 36px;
    }
    .tagline {
      font-size: 17px;
    }
    .subtitle {
      margin-bottom: 2.5rem;
    }
    .portal-card {
      flex: 0 0 100%;
    }
  }
</style>
